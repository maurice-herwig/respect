spec AutonomousVehicle

type Speed = Int(0..10);
type Light = {RED, YELLOW, GREEN};

env boolean pedestrian;
env boolean crosswalk;
env Light trafficLight;

sys Speed speed;

asm alwEv trafficLight=GREEN & !pedestrian;

gar alw (pedestrian | trafficLight!=GREEN) -> speed=0;
gar alw crosswalk -> speed<5;

gar alwEv trafficLight=GREEN & !pedestrian & speed>0;
