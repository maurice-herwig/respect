spec Forklift

type ObstacleStatus = {BLOCKED, CLEAR};
type MovementState = {STOP, FWD, BWD};

env ObstacleStatus obstacle;

sys MovementState movement;

gar ini movement=STOP;

gar alw obstacle=BLOCKED -> movement!=FWD;
gar alwEv movement=FWD;

asm alw movement=STOP -> next(obstacle)=obstacle;
asm alw movement=BWD -> next(obstacle)=CLEAR;
asm alwEv obstacle=CLEAR;
