spec RobotGridMove

type Coord = Int(0..5);
type Move = {UP, DOWN, LEFT, RIGHT, STAY};

env Coord[2] rob;

sys Move move;

predicate sameX():
 next(rob[0])=rob[0];

predicate sameY():
 next(rob[1])=rob[1];

asm alw (move=UP & rob[1]>0) implies (next(rob[1])=rob[1]-1 & sameX());
asm alw (move=UP & rob[1]=0) implies (next(rob[1])=rob[1] & sameX());

asm alw (move=DOWN & rob[1]<5) implies (next(rob[1])=rob[1]+1 & sameX());
asm alw (move=DOWN & rob[1]=5) implies (next(rob[1])=rob[1] & sameX());

asm alw (move=LEFT & rob[0]>0) implies (next(rob[0])=rob[0]-1 & sameY());
asm alw (move=LEFT & rob[0]=0) implies (next(rob[0])=rob[0] & sameY());

asm alw (move=RIGHT & rob[0]<5) implies (next(rob[0])=rob[0]+1 & sameY());
asm alw (move=RIGHT & rob[0]=5) implies (next(rob[0])=rob[0] & sameY());

asm alw move=STAY implies (next(rob[0])=rob[0] & next(rob[1])=rob[1]);

gar alw true;
