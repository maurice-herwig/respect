spec GridA3

type Coord = Int(0..5);
type Move = {UP, DOWN, LEFT, RIGHT, STAY};

env Coord[2] rob;

sys Move move;

define initial := rob[0]=0 & rob[1]=0;
define final := rob[0]=5 & rob[1]=5;

predicate fix(Coord c):
  next(c)=c;

asm alw move=UP implies next(rob[1])=rob[1]-1 & fix(rob[0]);
asm alw move=DOWN implies next(rob[1])=rob[1]+1 & fix(rob[0]);
asm alw move=LEFT implies next(rob[0])=rob[0]-1 & fix(rob[1]);
asm alw move=RIGHT implies next(rob[0])=rob[0]+1 & fix(rob[1]);
asm alw move=STAY implies fix(rob[0]) & fix(rob[1]);

gar alw initial implies next(final);
gar alwEv initial;
