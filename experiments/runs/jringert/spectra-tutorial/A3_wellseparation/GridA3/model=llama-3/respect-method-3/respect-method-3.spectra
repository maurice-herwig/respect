spec GridA3

type Coord = Int(0..5);

env Coord robX;
env Coord robY;

sys {UP, DOWN, LEFT, RIGHT, STAY} move;

define initialPos := robX=0 & robY=0;
define finalPos := robX=5 & robY=5;

predicate fix(Coord c):
 next(c)=c;

asm alw move=UP implies next(robY)=robY-1 & fix(robX);
asm alw move=DOWN implies next(robY)=robY+1 & fix(robX);
asm alw move=LEFT implies next(robX)=robX-1 & fix(robY);
asm alw move=RIGHT implies next(robX)=robX+1 & fix(robY);
asm alw move=STAY implies fix(robX) & fix(robY);

gar alw initialPos implies next(finalPos);
gar alwEv initialPos;
