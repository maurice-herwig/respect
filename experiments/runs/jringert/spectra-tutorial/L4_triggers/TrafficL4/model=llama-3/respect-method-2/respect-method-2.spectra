spec TrafficL4

env boolean carA;
env boolean carB;

sys boolean greenA;
sys boolean greenB;

asm carBWithin3AfterCarA(carB, carA);

gar alw !(greenA & greenB);

gar greenAWithin4AfterWaiting(greenA, carA);

pattern carBWithin3AfterCarA(s, p) {
  var { S0, S1, S2, S3 } state;

  state=S0;

  alw ((state=S0 & ((!p) | (p & s)) & next(state=S0)) |
  (state=S0 & (p & !s) & next(state=S1)) |
  (state=S1 & (s) & next(state=S0)) |
  (state=S1 & (!s) & next(state=S2)) |
  (state=S2 & (s) & next(state=S0)) |
  (state=S2 & (!s) & next(state=S3)) |
  (state=S3 & (s) & next(state=S0)));
}

pattern greenAWithin4AfterWaiting(s, p) {
  var { S0, S1, S2, S3, S4 } state;

  state=S0;

  alw ((state=S0 & !(p & !s) & next(state=S0)) |
  (state=S0 & (p & !s) & next(state=S1)) |
  (state=S1 & (s) & next(state=S0)) |
  (state=S1 & (!s) & next(state=S2)) |
  (state=S2 & (s) & next(state=S0)) |
  (state=S2 & (!s) & next(state=S3)) |
  (state=S3 & (s) & next(state=S0)) |
  (state=S3 & (!s) & next(state=S4)) |
  (state=S4 & (s) & next(state=S0)));
}
