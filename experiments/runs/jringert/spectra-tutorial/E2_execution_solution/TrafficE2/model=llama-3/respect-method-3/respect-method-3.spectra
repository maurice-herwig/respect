spec TrafficE2

env boolean carA;
env boolean carB;
env boolean emergency;

sys boolean greenA;
sys boolean greenB;

asm alwEv carA;
asm alwEv carB;

gar ini !greenA & !greenB;
gar alw !(greenA & greenB);
gar alw emergency -> (!greenA & !greenB);
gar alw !carA -> !greenA;
gar alw !carB -> !greenB;
gar alwEv (emergency | greenA);
gar alwEv (emergency | greenB);
