spec Patrolling

type TargetCoord = Int(0..5);
type RobotCoord = Int(0..4);
type Targets = TargetCoord[3][2];
type BlockedFlags = boolean[3];

env Targets targets;

sys RobotCoord robotX;
sys RobotCoord robotY;
sys BlockedFlags IsTargetBlocked;

gar alwEv IsTargetBlocked[0];
gar alwEv !IsTargetBlocked[0];
gar alwEv IsTargetBlocked[1];
gar alwEv !IsTargetBlocked[1];
gar alwEv IsTargetBlocked[2];
gar alwEv !IsTargetBlocked[2];
