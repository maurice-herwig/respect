spec Patrolling

type Coord = Int(0..3);

env Coord[3][2] goals;
env boolean[3] isGoalBlocked;

sys Coord robotX;
sys Coord robotY;

asm alwEv isGoalBlocked[0];
asm alwEv !isGoalBlocked[0];
asm alwEv isGoalBlocked[1];
asm alwEv !isGoalBlocked[1];
asm alwEv isGoalBlocked[2];
asm alwEv !isGoalBlocked[2];
