spec GuardDimensions

env Int(0..7) guard1;
env Int(0..7) guard2;

asm alw (
  next(guard1) = guard1 |
  (guard1 > 0 & next(guard1) = guard1 - 1) |
  (guard1 < 7 & next(guard1) = guard1 + 1)
);

asm alw (
  next(guard2) = guard2 |
  (guard2 > 0 & next(guard2) = guard2 - 1) |
  (guard2 < 7 & next(guard2) = guard2 + 1)
);
