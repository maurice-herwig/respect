spec Guards

type GuardPos = Int(0..7);

env GuardPos guard0;
env GuardPos guard1;

asm alw ((guard0=0 -> (next(guard0)=0 | next(guard0)=1)) &
         (guard0=7 -> (next(guard0)=6 | next(guard0)=7)) &
         (guard0>0 & guard0<7 -> (next(guard0)=guard0-1 | next(guard0)=guard0 | next(guard0)=guard0+1)));

asm alw ((guard1=0 -> (next(guard1)=0 | next(guard1)=1)) &
         (guard1=7 -> (next(guard1)=6 | next(guard1)=7)) &
         (guard1>0 & guard1<7 -> (next(guard1)=guard1-1 | next(guard1)=guard1 | next(guard1)=guard1+1)));
