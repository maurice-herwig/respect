spec EscapingGuard

env Int(0..7) guardX;
env Int(0..7) guardY;

asm alw (
  next(guardX) = guardX |
  (guardX < 7 & next(guardX) = guardX + 1) |
  (guardX > 0 & next(guardX) = guardX - 1)
);

asm alw (
  next(guardY) = guardY |
  (guardY < 7 & next(guardY) = guardY + 1) |
  (guardY > 0 & next(guardY) = guardY - 1)
);
