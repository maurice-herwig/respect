spec EscapingGuard

type Coord = Int(0..7);

env Coord obstacle0X;
env Coord obstacle0Y;
env Coord obstacle1X;
env Coord obstacle1Y;
env Coord obstacle2X;
env Coord obstacle2Y;
env Coord obstacle3X;
env Coord obstacle3Y;

env Coord target0X;
env Coord target0Y;
env Coord target1X;
env Coord target1Y;
env Coord target2X;
env Coord target2Y;

sys Coord robotX;
sys Coord robotY;

asm ini obstacle0X=1 & obstacle0Y=1;
asm ini obstacle1X=2 & obstacle1Y=2;
asm ini obstacle2X=3 & obstacle2Y=3;
asm ini obstacle3X=4 & obstacle3Y=4;

asm ini target0X=5 & target0Y=5;
asm ini target1X=6 & target1Y=6;
asm ini target2X=7 & target2Y=7;

gar ini robotX=0 & robotY=0;
