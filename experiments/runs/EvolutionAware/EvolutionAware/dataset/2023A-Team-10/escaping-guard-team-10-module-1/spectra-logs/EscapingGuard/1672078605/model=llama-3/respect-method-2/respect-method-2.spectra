spec EscapingGuard

type Coord = Int(0..7);

env Coord obstacleX;
env Coord obstacleY;
env Coord targetX;
env Coord targetY;

sys Coord robotX;
sys Coord robotY;

predicate sameOrAdjacent(Coord current, Coord nextValue):
  nextValue = current | nextValue = current + 1 | nextValue = current - 1;

gar ini robotX = 7 & robotY = 0;

gar alw sameOrAdjacent(robotX, next(robotX));
gar alw sameOrAdjacent(robotY, next(robotY));
