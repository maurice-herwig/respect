spec EscapingGuard

type Coord = Int(0..7);

env Coord obstacleX;
env Coord obstacleY;
env Coord targetX;
env Coord targetY;

sys Coord robotX;
sys Coord robotY;

predicate unitStep (Coord c):
  next(c)=c |
  (c < 7 & next(c)=c+1) |
  (c > 0 & next(c)=c-1);

gar ini robotX=7 & robotY=0;
gar alw unitStep(robotX) & unitStep(robotY);
