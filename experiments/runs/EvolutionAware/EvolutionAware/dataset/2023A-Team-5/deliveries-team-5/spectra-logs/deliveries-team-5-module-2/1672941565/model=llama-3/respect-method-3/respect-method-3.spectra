spec RobotElevator

define DX := 5;
define DY := 5;

type XCoord = Int(0..DX);
type YCoord = Int(0..DY);

env YCoord elevator;

sys XCoord robotX0;
sys YCoord robotY0;
sys XCoord robotX1;
sys YCoord robotY1;

asm alw next(elevator)=elevator |
        next(elevator)=elevator+1 |
        next(elevator)=elevator-1;
asm alwEv elevator=0;
asm alwEv elevator=DY;

gar alw robotX0=0 -> robotY0=elevator;
gar alw robotX1=0 -> robotY1=elevator;
