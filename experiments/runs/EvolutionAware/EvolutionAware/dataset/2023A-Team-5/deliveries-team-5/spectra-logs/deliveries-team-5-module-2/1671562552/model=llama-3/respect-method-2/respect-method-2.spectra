spec ElevatorRobots

define DX := 5;
define DY := 5;

type XCoord = Int(0..DX);
type YCoord = Int(0..DY);

env YCoord elevatorPos;

sys XCoord robotX0;
sys YCoord robotY0;
sys XCoord robotX1;
sys YCoord robotY1;

asm alw next(elevatorPos) = elevatorPos |
        next(elevatorPos) = elevatorPos + 1 |
        next(elevatorPos) = elevatorPos - 1;

asm alwEv elevatorPos = 0;
asm alwEv elevatorPos = DY;

gar alw robotX0 = 0 -> next(robotY0) = elevatorPos;
gar alw robotX1 = 0 -> next(robotY1) = elevatorPos;
