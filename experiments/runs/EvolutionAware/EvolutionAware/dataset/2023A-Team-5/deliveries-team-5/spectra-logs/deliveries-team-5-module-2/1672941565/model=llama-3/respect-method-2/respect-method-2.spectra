spec ElevatorRobot

define DX := 5;
define DY := 5;

type XCoord = Int(0..DX);
type YCoord = Int(0..DY);

env YCoord elevatorY;

sys XCoord robotX0;
sys YCoord robotY0;
sys XCoord robotX1;
sys YCoord robotY1;

asm alw next(elevatorY)=elevatorY |
        next(elevatorY)=elevatorY+1 |
        next(elevatorY)=elevatorY-1;
asm alwEv elevatorY=0;
asm alwEv elevatorY=DY;

gar alw robotX0=0 -> robotY0=elevatorY;
gar alw robotX1=0 -> robotY1=elevatorY;
