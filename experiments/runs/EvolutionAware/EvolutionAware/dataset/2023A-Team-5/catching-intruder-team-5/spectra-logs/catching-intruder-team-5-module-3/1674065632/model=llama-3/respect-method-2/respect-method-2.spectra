spec IntruderRobotY1Ranges

type Coord = Int(0..10);

env Coord intruderX;
env Coord intruderY;

sys Coord robotX0;
sys Coord robotY0;
sys Coord robotX1;
sys Coord robotY1;

asm alw intruderY=1 implies (intruderX<2 | intruderX>5);

gar alw robotY0=1 implies (robotX0<2 | robotX0>5);
gar alw robotY1=1 implies (robotX1<2 | robotX1>5);
