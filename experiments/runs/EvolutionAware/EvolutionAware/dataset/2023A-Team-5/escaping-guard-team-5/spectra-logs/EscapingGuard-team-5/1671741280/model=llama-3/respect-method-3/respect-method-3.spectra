spec EscapingGuard

define D := 7;

type Coord = Int(0..D);

sys Coord robotX;
sys Coord robotY;

predicate stepAtMostOne(Coord c):
  next(c)=c |
  (c < D & next(c)=c+1) |
  (c > 0 & next(c)=c-1);

define atT1 := robotX=0 & robotY=0;
define atT2 := robotX=D & robotY=D;
define atT3 := robotX=0 & robotY=D;

gar ini robotX=D & robotY=0;

gar alw stepAtMostOne(robotX);
gar alw stepAtMostOne(robotY);

gar alwEv atT1;
gar alwEv atT2;
gar alwEv atT3;
