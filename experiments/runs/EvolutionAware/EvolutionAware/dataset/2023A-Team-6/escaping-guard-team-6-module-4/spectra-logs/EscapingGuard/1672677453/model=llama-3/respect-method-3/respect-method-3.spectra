spec RobotGuardSafe

type RobotCoord = Int(0..4);
type GuardCoord = Int(0..3);

env GuardCoord guardX;
env GuardCoord guardY;

sys RobotCoord robotX;
sys RobotCoord robotY;

predicate outsideGuardFootprint(RobotCoord rx, RobotCoord ry, GuardCoord gx, GuardCoord gy):
  !((rx = gx | rx = gx + 1) & (ry = gy | ry = gy + 1));

gar alw outsideGuardFootprint(robotX, robotY, guardX, guardY);
