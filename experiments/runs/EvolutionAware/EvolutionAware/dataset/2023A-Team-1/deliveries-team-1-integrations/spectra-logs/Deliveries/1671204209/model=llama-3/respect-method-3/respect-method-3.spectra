spec TwoRobotsDelivery

define DX := 5;
define DY := 5;

type XCoord = Int(0..DX);
type YCoord = Int(0..DY);

env XCoord[2] deliveriesX;
env YCoord[2] deliveriesY;
env YCoord elevatorY;

sys XCoord robotX0;
sys YCoord robotY0;
sys XCoord robotX1;
sys YCoord robotY1;

gar alwEv robotX0=deliveriesX[0] & robotY0=deliveriesY[0];
gar alwEv robotX1=deliveriesX[1] & robotY1=deliveriesY[1];
