spec RobotDeliveries

type Coord = Int(0..20);

env Coord[2] deliveriesX;
env Coord[2] deliveriesY;
env Coord elevatorY;

sys Coord robotX0;
sys Coord robotY0;
sys Coord robotX1;
sys Coord robotY1;

gar alwEv robotX0 = deliveriesX[0] & robotY0 = deliveriesY[0];
gar alwEv robotX1 = deliveriesX[1] & robotY1 = deliveriesY[1];
