spec Deliveries

type Coord = Int(1..5);

sys Coord robotX0;
sys Coord robotY0;
sys Coord robotX1;
sys Coord robotY1;

gar ini robotY0 = 5 & robotY1 = 5;

gar alw (
  (next(robotX0) = robotX0 | next(robotX0) = robotX0 + 1 | next(robotX0) = robotX0 - 1) &
  (next(robotY0) = robotY0 | next(robotY0) = robotY0 + 1 | next(robotY0) = robotY0 - 1) &
  (next(robotX1) = robotX1 | next(robotX1) = robotX1 + 1 | next(robotX1) = robotX1 - 1) &
  (next(robotY1) = robotY1 | next(robotY1) = robotY1 + 1 | next(robotY1) = robotY1 - 1)
);
