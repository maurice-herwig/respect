spec TwoRobotsIntruder

type Coord = Int(0..6);

env Coord intruderX;
env Coord intruderY;

sys Coord robot1X;
sys Coord robot1Y;
sys Coord robot2X;
sys Coord robot2Y;

define intruderAtObstacleRow := intruderY = 1;
define robot1AtObstacleRow := robot1Y = 1;
define robot2AtObstacleRow := robot2Y = 1;

gar ini robot1X = 0 & robot1Y = 0;
gar ini robot2X = 5 & robot2Y = 0;
