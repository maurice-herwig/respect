spec IntruderTurns

env Int(0..7) intruderX;
env Int(0..7) intruderY;

sys Int(0..7) robotX0;
sys Int(0..7) robotY0;
sys Int(0..7) robotX1;
sys Int(0..7) robotY1;
sys Int(0..3) turns;

gar ini turns=0;

gar alw ((next(intruderX)=intruderX & next(intruderY)=intruderY) implies next(turns)=turns+1);

gar alwEv turns=3;
