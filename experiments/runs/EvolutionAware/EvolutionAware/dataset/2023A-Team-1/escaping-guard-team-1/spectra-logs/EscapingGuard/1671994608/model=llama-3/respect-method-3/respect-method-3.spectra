spec EscapingGuard

define staticObstaclesX := 2;
define upper := 5;

type Coord = Int(0..upper);

sys Coord robotX;
sys Coord robotY;

define onStaticObstacle :=
  robotX = staticObstaclesX &
  (robotY = 2 | robotY = 3 | robotY = 4 | robotY = 5);

predicate moveRight(Coord x):
  x < upper & next(x) = x + 1;

predicate moveLeft(Coord x):
  x > 0 & next(x) = x - 1;

predicate stay(Coord c):
  next(c) = c;

gar alw
  (stay(robotX) & stay(robotY)) |
  (moveRight(robotX) & stay(robotY)) |
  (moveLeft(robotX) & stay(robotY)) |
  (stay(robotX) & moveRight(robotY)) |
  (stay(robotX) & moveLeft(robotY));

gar alw !onStaticObstacle;
