spec Deliveries

define DX := 5;
define DY := 5;

type DimX = Int(0..DX);
type DimY = Int(0..DY);
type Coord = Int(0..DY);

sys DimX robotX0;
sys DimY robotY0;
sys DimX robotX1;
sys DimY robotY1;

gar ini robotX0=0 & robotY0=0 & robotX1=0 & robotY1=0;

gar alw robotX0 >= 0 & robotX0 <= DX &
        robotY0 >= 0 & robotY0 <= DY &
        robotX1 >= 0 & robotX1 <= DX &
        robotY1 >= 0 & robotY1 <= DY;
