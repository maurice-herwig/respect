spec Deliveries

type Coord = Int(0..4);

env Coord p0X;
env Coord p0Y;
env Coord p1X;
env Coord p1Y;

sys Coord robotX0;
sys Coord robotY0;
sys Coord robotX1;
sys Coord robotY1;

define DX := 5;
define DY := 5;

define r0AtPack := (robotX0 = p0X & robotY0 = p0Y) | (robotX0 = p1X & robotY0 = p1Y);
define r1AtPack := (robotX1 = p0X & robotY1 = p0Y) | (robotX1 = p1X & robotY1 = p1Y);

asm alw p0Y != 0;
asm alw p1Y != 0;

gar alw true;
