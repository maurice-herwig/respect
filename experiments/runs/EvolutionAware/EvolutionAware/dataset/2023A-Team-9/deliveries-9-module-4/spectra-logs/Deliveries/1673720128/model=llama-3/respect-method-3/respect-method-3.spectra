spec RobotsElevatorGround

type Coord = Int(0..5);

env Coord robotX0;
env Coord robotY0;
env Coord robotX1;
env Coord robotY1;

sys boolean elevatorAndGround0;
sys boolean elevatorAndGround1;

gar ini !elevatorAndGround0 & !elevatorAndGround1;

gar alw (robotY0 < 5 & next(robotY0) = 5) -> next(elevatorAndGround0);
gar alw (robotY1 < 5 & next(robotY1) = 5) -> next(elevatorAndGround1);
