spec Deliveries

define DX := 5;
define DY := 5;

type Coord = Int(0..DY);

sys Coord robotX0;
sys Coord robotY0;
sys Coord robotX1;
sys Coord robotY1;

gar ini robotX0 = 0 & robotY0 = 0 & robotX1 = DX & robotY1 = DY;

gar alw robotX0 >= 0 & robotX0 <= DX;
gar alw robotY0 >= 0 & robotY0 <= DY;
gar alw robotX1 >= 0 & robotX1 <= DX;
gar alw robotY1 >= 0 & robotY1 <= DY;
