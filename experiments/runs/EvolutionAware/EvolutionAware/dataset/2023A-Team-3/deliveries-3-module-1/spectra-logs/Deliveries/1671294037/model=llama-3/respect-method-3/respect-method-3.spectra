spec ElevatorMethod3

type Coord = Int(0..5);

env Coord elevatorY;

sys Coord robotX0;
sys Coord robotY0;
sys Coord robotX1;
sys Coord robotY1;

asm alw next(elevatorY)=elevatorY |
        next(elevatorY)=elevatorY+1 |
        next(elevatorY)=elevatorY-1;

asm alwEv elevatorY=0;
asm alwEv elevatorY=5;
