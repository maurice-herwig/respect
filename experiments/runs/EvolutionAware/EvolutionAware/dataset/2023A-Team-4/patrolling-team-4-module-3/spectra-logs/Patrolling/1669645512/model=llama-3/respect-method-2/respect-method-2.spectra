spec Patrolling

define atCharge := x=4 & y=0;

env boolean functioning;

sys Int(0..4) x;
sys Int(0..4) y;
sys Int(0..15) nonChargeCount;
sys Int(0..2) chargeHold;

asm alw !atCharge implies functioning;

gar ini atCharge implies chargeHold=2;
gar ini !atCharge implies chargeHold=0;
gar ini atCharge implies nonChargeCount=0;
gar ini !atCharge implies nonChargeCount=1;

gar alw !atCharge & next(atCharge) implies next(chargeHold)=2;
gar alw chargeHold>0 implies atCharge & next(atCharge) & next(chargeHold)=chargeHold-1;
gar alw chargeHold=0 & atCharge & next(!atCharge) implies next(chargeHold)=0;

gar alw atCharge implies next(nonChargeCount)=0;
gar alw !atCharge & next(atCharge) implies next(nonChargeCount)=0;
gar alw !atCharge & nonChargeCount<15 & next(!atCharge) implies next(nonChargeCount)=nonChargeCount+1;
gar alw !atCharge & nonChargeCount=15 & next(!atCharge) implies next(nonChargeCount)=15;

gar alw nonChargeCount=15 implies next(atCharge);
