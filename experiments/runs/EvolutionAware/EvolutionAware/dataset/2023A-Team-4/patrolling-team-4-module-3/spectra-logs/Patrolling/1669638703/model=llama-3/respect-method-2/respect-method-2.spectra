spec Patrolling

sys Int(0..4) robotX;
sys Int(0..4) robotY;
sys Int(0..15) awayTimer;
sys Int(0..3) chargeTimer;

define atCharge := robotX=4 & robotY=0;

gar alw !atCharge -> chargeTimer=0;
gar alw atCharge -> chargeTimer>0;

gar alw !atCharge & awayTimer<15 -> next(awayTimer)=awayTimer+1;
gar alw !atCharge & awayTimer=15 -> next(atCharge);
gar alw atCharge -> next(awayTimer)=0;

gar alw !atCharge & next(atCharge) -> next(chargeTimer)=1;
gar alw atCharge & chargeTimer<3 -> next(atCharge) & next(chargeTimer)=chargeTimer+1;
