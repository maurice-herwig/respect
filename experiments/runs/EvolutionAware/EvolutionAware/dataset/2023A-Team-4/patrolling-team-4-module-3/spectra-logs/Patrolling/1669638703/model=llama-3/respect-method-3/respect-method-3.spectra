spec Patrolling

type Coord = Int(0..4);
type AwayCount = Int(0..15);
type HoldCount = Int(0..3);

sys Coord robotX;
sys Coord robotY;
sys AwayCount awayCount;
sys HoldCount holdCount;

define atCharging := robotX=4 & robotY=0;

gar alw atCharging -> awayCount=0;
gar alw !atCharging -> holdCount=0;

gar alw (!atCharging & awayCount<14) ->
  (next(awayCount)=awayCount+1 | next(atCharging));

gar alw (!atCharging & awayCount>=14) -> next(atCharging);

gar alw (!atCharging & next(atCharging)) -> next(holdCount)=0;

gar alw atCharging & holdCount<2 ->
  next(atCharging) & next(holdCount)=holdCount+1;

gar alw atCharging & holdCount>=2 ->
  (next(atCharging) | !next(atCharging));
