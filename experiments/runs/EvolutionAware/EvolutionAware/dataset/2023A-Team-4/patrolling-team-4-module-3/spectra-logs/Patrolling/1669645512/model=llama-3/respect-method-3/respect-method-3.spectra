spec Patrolling

sys Int(0..4) x;
sys Int(0..4) y;
sys Int(0..15) away;
sys Int(0..2) hold;

define atCharge := x=4 & y=0;

gar ini (atCharge -> (away=0 & hold=2)) & (!atCharge -> (away=1 & hold=0));

gar alw x>=0 & x<=4 & y>=0 & y<=4;

gar alw atCharge -> next(away)=0;
gar alw (!atCharge & next(atCharge)) -> next(away)=0;
gar alw (!atCharge & !next(atCharge) & away<15) -> next(away)=away+1;
gar alw (!atCharge & !next(atCharge) & away=15) -> next(away)=15;

gar alw (!atCharge & next(atCharge)) -> next(hold)=2;
gar alw (hold=2 -> atCharge & next(atCharge) & next(hold)=1);
gar alw (hold=1 -> atCharge & next(atCharge) & next(hold)=0);
gar alw (!atCharge -> hold=0);
gar alw (atCharge & hold=0 & next(!atCharge)) -> next(hold)=0;
gar alw (atCharge & hold=0 & next(atCharge)) -> next(hold)=0;

gar alwEv (atCharge | away!=15);
