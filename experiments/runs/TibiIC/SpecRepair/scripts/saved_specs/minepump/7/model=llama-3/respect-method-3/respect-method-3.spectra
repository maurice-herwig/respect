spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

asm ini !highWater & !methane;
gar ini !pump;

gar alw highWater -> (next(highWater) | next(pump));
gar alw (methane & highWater) -> (next(methane) | next(!pump));

asm alw pump -> next(!highWater);
asm alw !highWater -> (next(!highWater) | next(!methane));
