spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

asm ini !highWater & !methane;
asm alw (pump & PREV(pump)) -> next(!highWater);
asm alw pump -> (!highWater | !methane);

gar ini !pump;
gar alw (highWater & pump) -> next(pump);
gar alw (highWater & !pump) -> next(!pump);
gar alw methane -> next(!pump);
