spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;
sys boolean pumpWasOn;

asm ini !highWater & !methane;
asm alw (pumpWasOn & pump) -> next(!highWater);
asm alw !highWater -> next(!highWater | !methane);

gar ini !pump & !pumpWasOn;
gar alw (pump -> next(pumpWasOn)) & (!pump -> next(!pumpWasOn));
gar alw highWater -> (methane | next(pump));
gar alw methane -> (pump | next(!pump));
