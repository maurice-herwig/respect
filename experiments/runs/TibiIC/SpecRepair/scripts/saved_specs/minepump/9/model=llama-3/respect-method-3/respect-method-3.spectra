spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

asm ini !highWater & !methane;

// If the pump remains on for two consecutive moments, high water decreases.
asm alw (PREV(pump) & pump) -> !highWater;

// If there is no high water, the environment either keeps no high water
// or methane is detected in the next moment.
asm alw !highWater -> next(!highWater | methane);

gar ini !pump;

// High water forbids the pump in the current moment.
gar alw highWater -> !pump;

// Methane with high water forces the pump off at the next moment.
gar alw (methane & highWater) -> next(!pump);
