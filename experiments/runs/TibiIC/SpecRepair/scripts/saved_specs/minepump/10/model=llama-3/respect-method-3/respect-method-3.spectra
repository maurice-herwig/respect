spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;

asm ini !highwater & !methane;

asm alw (PREV(pump) & pump) -> !next(highwater);

asm alw !highwater -> (!next(highwater) | !next(methane));

gar ini !pump;

gar alw (highwater & !methane) -> pump;

gar alw methane -> !pump;
