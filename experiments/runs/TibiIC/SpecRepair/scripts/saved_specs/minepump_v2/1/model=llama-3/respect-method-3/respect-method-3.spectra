spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;
sys boolean prevPump;

asm ini !highWater & !methane;
asm alw (prevPump & pump) -> next(!highWater);
asm alw next(!highWater) | next(!methane);

gar ini !pump & !prevPump;
gar alw next(prevPump) <-> pump;
gar alw highWater -> (pump | next(pump));
gar alw methane -> next(!pump);
