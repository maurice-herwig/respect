spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;
sys boolean prevMethane;

asm ini !highWater & !methane;
asm alw pump -> !next(highWater);
asm alw pump -> (!highWater | !methane);

gar ini !pump & !prevMethane;
gar alw next(prevMethane) <-> methane;
gar alw (highWater & !methane & !prevMethane) -> pump;
gar alw methane -> (!pump & !next(pump));
gar alw pump -> highWater;
