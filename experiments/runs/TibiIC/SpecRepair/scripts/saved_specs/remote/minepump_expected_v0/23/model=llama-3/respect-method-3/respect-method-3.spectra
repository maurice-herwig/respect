spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

asm ini !highWater & !methane;
asm alw pump & PREV(pump) -> next(!highWater);
asm alw !highWater -> (next(!highWater) | next(!methane));

gar ini !pump;
gar alw highWater -> next(pump);
gar alw methane -> (highWater | !pump | next(!pump));
