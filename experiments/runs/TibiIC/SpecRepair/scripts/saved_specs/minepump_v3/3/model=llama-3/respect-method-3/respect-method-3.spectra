spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;

asm ini !highwater & !methane;

gar ini !pump;

gar alw (highwater & !methane) -> next(pump);
gar alw methane -> (next(methane) | next(!pump));

asm alw (PREV(pump) & pump) -> !highwater;
asm alw !highwater -> (next(!highwater) | next(!methane));
