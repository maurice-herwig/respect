spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;
sys boolean prevPump;
sys boolean prevLowWater;

asm alw (pump & prevPump) -> next(!highwater);
asm alw pump -> (!highwater | !methane);

gar ini !prevPump & prevLowWater;
gar alw next(prevPump)=pump;
gar alw next(prevLowWater)=!highwater;
gar alw highwater -> next(pump);
gar alw methane -> (prevLowWater | next(!pump));
