spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

asm alw pump -> next(!highWater);
asm alw !methane -> !highWater;
asm alw pump -> (!highWater | !methane);
asm alw !highWater -> next(!highWater | !methane);

gar alw highWater -> next(pump);
gar alw methane -> next(!pump);
