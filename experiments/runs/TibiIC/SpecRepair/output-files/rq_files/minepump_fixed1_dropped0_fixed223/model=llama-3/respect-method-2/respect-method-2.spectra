spec Minepump

pattern eventually_after(response, trigger) {
  var { S0, S1 } state;

  ini state=S0;

  alw ((state=S0 & ((!trigger) | (trigger & response)) & next(state=S0)) |
       (state=S0 & (trigger & !response) & next(state=S1)) |
       (state=S1 & response & next(state=S0)) |
       (state=S1 & !response & next(state=S1)));

  alwEv (state=S0);
}

env boolean highWater;
env boolean methane;

sys boolean pump;

asm eventually_after(!highWater, highWater & PREV(!pump));

gar G(methane -> (next(pump) | !highWater));
gar G(!methane -> next(!pump));
