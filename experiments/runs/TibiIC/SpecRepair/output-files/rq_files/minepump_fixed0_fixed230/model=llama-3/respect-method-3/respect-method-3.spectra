spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;
sys boolean prevPump;

asm alw (prevPump & pump) -> next(!highwater);
asm alw pump -> (!highwater | !methane);

gar ini !prevPump;
gar alw next(prevPump) <-> pump;
gar alw (highwater & !methane) -> next(pump);
gar alw methane -> next(!pump);
