spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;
sys boolean pumpWasInactive;

asm alw methane & pumpWasInactive -> next(!highWater | pump);

gar ini pumpWasInactive;
gar alw next(pumpWasInactive) <-> !pump;
gar alw methane -> (next(pump) | !highWater);
gar alw !methane -> next(!pump);
