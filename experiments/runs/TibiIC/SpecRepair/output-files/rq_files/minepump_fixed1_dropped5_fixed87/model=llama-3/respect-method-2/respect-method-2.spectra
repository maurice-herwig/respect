spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

asm S_responds_to_P_globally(!highWater, !pump);

gar alw methane -> next(pump);
gar alw !methane -> next(!pump);

pattern S_responds_to_P_globally(s, p) {
  var { S0, S1 } state;

  ini state=S0;

  alw ((state=S0 & ((!p) | (p & s)) & next(state=S0)) |
  (state=S0 & (p & !s) & next(state=S1)) |
  (state=S1 & (s) & next(state=S0)) |
  (state=S1 & (!s) & next(state=S1)));

  alwEv (state=S0);
}
