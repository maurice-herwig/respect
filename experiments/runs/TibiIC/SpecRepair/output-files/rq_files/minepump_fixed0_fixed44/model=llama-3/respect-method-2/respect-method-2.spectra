spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;

// If the pump is on, the high-water indication clears next.
asm alw pump -> !next(highWater);

// Stated environment relation, preserved literally from the requirements.
asm alw !methane -> (!highWater | !methane);

// If water is high, the next pump status is constrained to a Boolean value.
gar alw highWater -> (next(pump) | !next(pump));

// Methane forces the pump to be off in the next state.
gar alw methane -> !next(pump);
