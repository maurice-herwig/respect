spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;
sys boolean prevPump;

asm alw (prevPump & pump) -> !next(highwater);
asm alw pump -> (!highwater | !methane);
asm alw methane -> (!next(highwater) | !next(methane));

gar ini !prevPump;
gar alw pump -> next(prevPump);
gar alw !pump -> !next(prevPump);
gar alw highwater -> next(pump);
gar alw methane -> !next(pump);
