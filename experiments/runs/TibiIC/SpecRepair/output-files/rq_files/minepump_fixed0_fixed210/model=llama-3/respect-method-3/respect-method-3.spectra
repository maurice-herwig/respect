spec Minepump

env boolean highWater;
env boolean methane;

sys boolean pump;
sys boolean previousPump;

asm alw (previousPump & pump) -> next(!highWater);
asm alw pump -> (!highWater | !methane);

gar alw next(previousPump) <-> pump;
gar alw highWater -> next(pump);
gar alw methane -> (highWater | next(!pump));
