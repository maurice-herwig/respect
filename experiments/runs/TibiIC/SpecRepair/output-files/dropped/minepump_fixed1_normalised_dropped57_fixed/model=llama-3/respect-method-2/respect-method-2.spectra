module MinepumpMethane

env boolean highwater;
env boolean methane;
sys boolean pump;

assumption -- highwater_change_after_pump_off
    G(PREV(!highwater)&highwater&PREV(!pump)->next(!highwater));

guarantee -- methane_detected_turn_pump_on
    G(methane->next(pump));

guarantee -- methane_absent_turn_pump_off
    G(!methane->next(!pump));
