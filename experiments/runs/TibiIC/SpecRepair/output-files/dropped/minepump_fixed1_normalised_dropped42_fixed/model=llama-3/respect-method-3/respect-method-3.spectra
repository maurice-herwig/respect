spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;
sys boolean pump_was_operating;

asm alw (methane & !methane & !pump_was_operating) -> (!next(highwater) | pump_was_operating);

gar alw methane -> (next(pump) | !highwater);
gar alw !methane -> !next(pump);
gar alw next(pump_was_operating) = pump;
