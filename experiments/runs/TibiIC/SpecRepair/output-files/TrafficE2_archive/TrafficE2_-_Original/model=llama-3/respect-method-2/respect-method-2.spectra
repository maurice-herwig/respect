spec TrafficE2

env boolean carA;
env boolean carB;
env boolean emergency;

sys boolean greenA;
sys boolean greenB;

asm alwEv carA;
asm alwEv carB;
asm alwEv !emergency;

asm alw (carA & !greenA) implies next(carA);
asm alw (carB & !greenB) implies next(carB);
asm alw (carA & greenA) implies !next(carA);
asm alw (carB & greenB) implies !next(carB);

gar ini !greenA & !greenB;
gar alw !(greenA & greenB);
gar alw emergency implies (!greenA & !greenB);
gar alwEv greenA;
gar alwEv greenB;
