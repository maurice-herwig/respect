spec Door

env boolean bellpressed;
env boolean bellrings;
env boolean doorhit;
env boolean knocksound;

sys boolean dooranswered;

asm ini !bellrings & !doorhit & !bellpressed & !knocksound;
asm alw bellpressed -> bellrings;
asm alw doorhit -> knocksound;

gar ini !dooranswered;
gar alw bellrings -> dooranswered;
gar alw knocksound -> dooranswered;
