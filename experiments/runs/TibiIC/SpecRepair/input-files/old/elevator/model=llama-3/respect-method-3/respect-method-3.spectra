spec Elevator

type Floor = {LOWER, MIDDLE, UPPER, NONE};
type Motor = {FWD, BWD, STOP};

env Floor floor;

sys boolean doorMot;
sys Motor elevMot;

gar ini elevMot=STOP;

gar alwEv elevMot=FWD;

gar alw floor=LOWER -> next(elevMot)=FWD;
gar alw floor=UPPER -> next(elevMot)=BWD;

asm alw elevMot=STOP -> floor!=NONE;
