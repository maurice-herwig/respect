spec TrafficE2

env boolean carA;
env boolean emergency;
env boolean police;

sys boolean greenA;

asm ini !carA & !emergency;
asm alwEv carA;
asm alw !police;

asm alw (carA & !greenA & !emergency) -> next(carA);
asm alw (carA & greenA & !police) -> next(!carA);

gar ini !greenA;
gar alw greenA;
gar alw !carA;
