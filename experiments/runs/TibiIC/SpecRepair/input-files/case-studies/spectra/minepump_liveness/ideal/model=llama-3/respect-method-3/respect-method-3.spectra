spec Minepump

env boolean highwater;
env boolean methane;

sys boolean pump;
sys boolean flag;
sys boolean pump_was_on;
sys boolean methane_was_absent;

asm ini !highwater & !methane;

asm alw (pump & pump_was_on) -> !next(highwater);
asm alw (highwater & (!pump_was_on | !pump)) -> next(highwater);
asm alwEv (!methane & methane_was_absent);

gar ini !pump & !pump_was_on & methane_was_absent;

gar alw next(pump_was_on) = pump;
gar alw next(methane_was_absent) = !methane;
gar alw (highwater & !methane) -> next(pump);
gar alw methane -> !next(pump);
gar alw highwater -> flag;
gar alwEv !flag;
