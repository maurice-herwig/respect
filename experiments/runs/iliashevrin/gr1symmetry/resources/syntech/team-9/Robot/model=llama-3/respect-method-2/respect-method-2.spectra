spec RobotGrid

sys Int(0..7) robotX;
sys Int(0..7) robotY;

gar ini robotX=0 & robotY=0;

gar alw (robotX=0 -> (next(robotX)=0 | next(robotX)=1));
gar alw (robotX=7 -> (next(robotX)=6 | next(robotX)=7));
gar alw ((robotX>0 & robotX<7) -> (next(robotX)=robotX-1 | next(robotX)=robotX | next(robotX)=robotX+1));

gar alw (robotY=0 -> (next(robotY)=0 | next(robotY)=1));
gar alw (robotY=7 -> (next(robotY)=6 | next(robotY)=7));
gar alw ((robotY>0 & robotY<7) -> (next(robotY)=robotY-1 | next(robotY)=robotY | next(robotY)=robotY+1));

gar alw (robotX=2 -> robotY=7);
gar alw (robotX=5 -> robotY=0);

gar alwEv (robotX=7 & robotY=7);
