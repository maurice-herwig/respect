controller_dir "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\branches\independent_test\round-00\spec-repair\synthesis\jit"
spec_name RG
spectra_file "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\branches\independent_test\round-00\spec-repair\skill_artifacts\final.spectra"
environment req, cl
system gr, val

test declared_variables:
  kind variable_ownership
  env req, cl
  sys gr, val

test safety_cl_true_forces_val_false_exhaustive:
  kind always_implication
  requirement "Whenever cl is true, the output val must be false."
  mode exhaustive
  max_depth 5
  max_paths 256
  domains:
    req false, true
    cl false, true
  when cl=true
  then val=false

test safety_cl_true_forces_val_false_bursts:
  kind always_implication
  requirement "Whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=true, cl=true
    req=false, cl=true
    req=true, cl=false
    req=false, cl=true
    req=false, cl=false
  when cl=true
  then val=false

test safety_no_grant_value_pair_while_cl_true_random:
  kind exclusion
  requirement "Whenever cl is true, the output val must be false."
  mode random
  runs 40
  max_depth 6
  seed 9004
  domains:
    req false, true
    cl false, true
  forbidden cl=true, val=true

test bounded_recurrence_when_environment_keeps_cl_clear:
  kind eventually_response
  requirement "The condition where both gr and val are true must occur infinitely often."
  trace:
    req=false, cl=false
    req=true, cl=false
    req=false, cl=false
    req=true, cl=false
    req=false, cl=false
    req=false, cl=false
  eventually gr=true, val=true
  within_steps 6
  require_closed_obligations true

test bounded_recurrence_after_closed_period_clears:
  kind eventually_response
  requirement "The condition where both gr and val are true must occur infinitely often."
  trace:
    req=false, cl=false
    req=true, cl=true
    req=false, cl=true
    req=true, cl=false
    req=false, cl=false
    req=false, cl=false
  when cl=false
  eventually gr=true, val=true
  within_steps 6
  require_closed_obligations true

test bounded_recurrence_with_fair_req_and_cl_exhaustive:
  kind eventually_response
  requirement "The input req must be false infinitely often, cl must be false infinitely often, and gr and val true must occur infinitely often."
  mode exhaustive
  max_depth 5
  max_paths 256
  domains:
    req false, true
    cl false, true
  when req=false, cl=false
  eventually gr=true, val=true
  within_steps 6
  require_closed_obligations false
