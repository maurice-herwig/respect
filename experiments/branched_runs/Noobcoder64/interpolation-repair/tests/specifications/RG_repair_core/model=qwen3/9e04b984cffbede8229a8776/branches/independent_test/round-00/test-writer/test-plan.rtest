controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\core\synthesis\jit
spec_name RG
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\core\skill_artifacts\final.spectra
environment req, cl
system gr, val

test declared_variables:
  kind variable_ownership
  env req, cl
  sys gr, val

test clearance_pulse_forces_val_false:
  kind always_implication
  requirement "Whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=true, cl=true
    req=false, cl=false
    req=true, cl=false
    req=false, cl=false
  when cl=true
  then val=false

test repeated_clearance_forces_val_false:
  kind always_implication
  requirement "Whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=false, cl=true
    req=false, cl=true
    req=true, cl=false
    req=false, cl=false
    req=true, cl=true
  when cl=true
  then val=false

test alternating_inputs_never_clearance_with_val:
  kind exclusion
  requirement "Whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=true, cl=false
    req=false, cl=true
    req=true, cl=false
    req=false, cl=true
    req=false, cl=false
  forbidden cl=true, val=true

test request_variations_do_not_override_clearance_safety:
  kind exclusion
  requirement "Whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=true, cl=true
    req=true, cl=true
    req=false, cl=false
    req=false, cl=true
    req=false, cl=false
  forbidden cl=true, val=true
