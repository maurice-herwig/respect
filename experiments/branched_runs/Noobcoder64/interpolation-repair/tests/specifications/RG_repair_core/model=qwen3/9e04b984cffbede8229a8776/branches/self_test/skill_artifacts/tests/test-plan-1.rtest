controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\core\synthesis\jit
spec_name RG
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\branches\self_test\specs\00_from_core.spectra
environment req, cl
system gr, val

test declared_variables:
  kind variable_ownership

test val_false_when_cl_true_concrete:
  kind always_implication
  requirement "Whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=true, cl=true
    req=false, cl=false
    req=true, cl=true
  when cl=true
  then val=false

test val_false_when_cl_true_exhaustive:
  kind always_implication
  requirement "Whenever cl is true, the output val must be false."
  mode exhaustive
  max_depth 4
  max_paths 64
  domains:
    req false, true
    cl false, true
  when cl=true
  then val=false

test gr_and_val_recur_on_clear_trace:
  kind eventually_response
  requirement "The condition where both gr and val are true must occur infinitely often."
  trace:
    req=false, cl=false
    req=true, cl=false
    req=false, cl=false
    req=true, cl=false
    req=false, cl=false
    req=true, cl=false
  eventually gr=true, val=true
  within_steps 6
  require_closed_obligations true
