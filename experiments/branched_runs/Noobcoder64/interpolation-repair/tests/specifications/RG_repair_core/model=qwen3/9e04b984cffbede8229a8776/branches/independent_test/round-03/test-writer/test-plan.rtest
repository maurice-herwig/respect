controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\branches\independent_test\round-02\spec-repair\synthesis\jit
spec_name RG
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\Noobcoder64\interpolation-repair\tests\specifications\RG_repair_core\model=qwen3\9e04b984cffbede8229a8776\branches\independent_test\round-02\spec-repair\skill_artifacts\final.spectra
environment req, cl
system gr, val

test declared_variables:
  kind variable_ownership
  env req, cl
  sys gr, val

test cl_true_forces_val_false_exhaustive:
  kind always_implication
  requirement "As a safety requirement, whenever cl is true, the output val must be false."
  mode exhaustive
  max_depth 6
  max_paths 256
  domains:
    req false, true
    cl false, true
  when cl=true
  then val=false

test cl_true_never_allows_val_true_trace:
  kind exclusion
  requirement "As a safety requirement, whenever cl is true, the output val must be false."
  trace:
    req=false, cl=false
    req=true, cl=true
    req=true, cl=true
    req=false, cl=false
    req=false, cl=true
    req=true, cl=false
  forbidden cl=true, val=true

test cl_true_never_allows_val_true_random:
  kind exclusion
  requirement "As a safety requirement, whenever cl is true, the output val must be false."
  mode random
  runs 50
  max_depth 6
  seed 17
  domains:
    req false, true
    cl false, true
  forbidden cl=true, val=true
