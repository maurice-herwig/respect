{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "methane_current_forces_pump_off_exhaustive",
      "kind": "always_implication",
      "requirement": "If methane is currently detected, the pump must be off in the next step.",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 256,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "then": {
        "pump": "false"
      }
    },
    {
      "name": "highwater_without_methane_forces_pump_on_exhaustive",
      "kind": "always_implication",
      "requirement": "If methane is not currently detected and the water level is currently high, the pump must be on in the next step.",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 256,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "then": {
        "pump": "true"
      }
    },
    {
      "name": "dry_safe_methane_keeps_pump_off_trace",
      "kind": "state_sequence",
      "requirement": "If methane is currently detected, the pump must be off in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "true"
        }
      ],
      "expect": [
        {
          "pump": "false"
        },
        {
          "pump": "false"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "water_without_methane_turns_pump_on_trace",
      "kind": "state_sequence",
      "requirement": "If methane is not currently detected and the water level is currently high, the pump must be on in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "pump": "true"
        },
        {
          "pump": "true"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_overrides_highwater_transition_trace",
      "kind": "state_sequence",
      "requirement": "If methane is currently detected, the pump must be off in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "alternating_water_and_methane_trace",
      "kind": "state_sequence",
      "requirement": "If methane is not currently detected and the water level is currently high, the pump must be on in the next step; if methane is currently detected, the pump must be off in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_response_absence_random",
      "kind": "response_absence",
      "requirement": "If methane is currently detected, the pump must be off in the next step.",
      "mode": "random",
      "runs": 50,
      "max_depth": 6,
      "seed": 125,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "absent": {
        "pump": "true"
      },
      "for_steps": 1
    }
