{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "highwater_without_methane_turns_pump_on_next",
      "kind": "state_sequence",
      "requirement": "If methane is not currently detected and the water level is currently high, the pump must be on in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_turns_pump_off_next",
      "kind": "state_sequence",
      "requirement": "If methane is currently detected, the pump must be off in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "false"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "alternating_demands_follow_previous_input",
      "kind": "state_sequence",
      "requirement": "The system operates continuously, reacting to the environment at each step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true"
        },
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_absence_response_on_exhaustive_inputs",
      "kind": "response_absence",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 64,
      "requirement": "If methane is currently detected, the pump must be off in the next step.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "absent": {
        "pump": "true"
      },
      "for_steps": 2
    },
    {
      "name": "highwater_no_methane_bounded_response",
      "kind": "eventually_response",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 64,
      "requirement": "If methane is not currently detected and the water level is currently high, the pump must be on in the next step.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      },
      "within_steps": 2,
      "require_closed_obligations": true
    },
    {
      "name": "seeded_random_continuous_operation",
      "kind": "eventually_response",
      "mode": "random",
      "runs": 40,
      "max_depth": 6,
      "seed": 125,
      "requirement": "The Minepump system controls a pump based on environmental inputs regarding water levels and methane gas presence.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      },
      "within_steps": 2
    }
  ],
