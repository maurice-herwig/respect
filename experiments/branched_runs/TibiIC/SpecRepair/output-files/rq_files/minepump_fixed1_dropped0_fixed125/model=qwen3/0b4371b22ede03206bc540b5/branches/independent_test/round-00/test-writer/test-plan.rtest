controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped0_fixed125\model=qwen3\0b4371b22ede03206bc540b5\core\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped0_fixed125\model=qwen3\0b4371b22ede03206bc540b5\core\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test highwater_without_methane_turns_pump_on_next:
  kind state_sequence
  requirement "If methane is not currently detected and the water level is currently high, the pump must be on in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=false
  expect:
    highwater=true
    pump=true

test methane_turns_pump_off_next:
  kind state_sequence
  requirement "If methane is currently detected, the pump must be off in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    highwater=false
    pump=false

test alternating_demands_follow_previous_input:
  kind state_sequence
  requirement "The system operates continuously, reacting to the environment at each step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=true, methane=false
  expect:
    highwater=true
    pump=true
    pump=false
    pump=true

test methane_absence_response_on_exhaustive_inputs:
  kind response_absence
  mode exhaustive
  max_depth 5
  max_paths 64
  requirement "If methane is currently detected, the pump must be off in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  absent pump=true
  for_steps 2

test highwater_no_methane_bounded_response:
  kind eventually_response
  mode exhaustive
  max_depth 5
  max_paths 64
  requirement "If methane is not currently detected and the water level is currently high, the pump must be on in the next step."
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true

test seeded_random_continuous_operation:
  kind eventually_response
  mode random
  runs 40
  max_depth 6
  seed 125
  requirement "The Minepump system controls a pump based on environmental inputs regarding water levels and methane gas presence."
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  eventually pump=true
  within_steps 2
