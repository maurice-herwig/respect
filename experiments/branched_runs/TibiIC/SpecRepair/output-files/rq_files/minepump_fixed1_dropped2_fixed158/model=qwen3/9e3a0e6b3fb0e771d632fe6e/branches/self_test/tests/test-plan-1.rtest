controller_dir C:/Users/mauri/OneDrive/Desktop/Repos/respect/experiments/branched_runs/TibiIC/SpecRepair/output-files/rq_files/minepump_fixed1_dropped2_fixed158/model=qwen3/9e3a0e6b3fb0e771d632fe6e/branches/self_test/synthesis/jit
spec_name Minepump
spectra_file C:/Users/mauri/OneDrive/Desktop/Repos/respect/experiments/branched_runs/TibiIC/SpecRepair/output-files/rq_files/minepump_fixed1_dropped2_fixed158/model=qwen3/9e3a0e6b3fb0e771d632fe6e/branches/self_test/specs/00_from_core.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership

test pump_on_next_after_safe_highwater:
  kind state_sequence
  requirement "If methane is false and highwater is true, then pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
  expect:
    highwater=true, methane=false
    pump=true

test pump_off_next_after_methane:
  kind state_sequence
  requirement "If methane is true, then pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    methane=true
    pump=false
