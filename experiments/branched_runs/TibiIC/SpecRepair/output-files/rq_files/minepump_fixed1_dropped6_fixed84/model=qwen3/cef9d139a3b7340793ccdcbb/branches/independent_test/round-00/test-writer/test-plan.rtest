controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed84\model=qwen3\cef9d139a3b7340793ccdcbb\core\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed84\model=qwen3\cef9d139a3b7340793ccdcbb\core\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test highwater_without_methane_turns_pump_on_next_step:
  kind state_sequence
  requirement "If highwater is true and methane is false, the system must set pump to true in the next step."
  trace:
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
  expect:
    highwater=false, methane=false
    highwater=true, methane=false
    pump=true

test methane_turns_pump_off_next_step:
  kind state_sequence
  requirement "If methane is true, the system must set pump to false in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    highwater=false, methane=false
    highwater=false, methane=true
    pump=false

test methane_overrides_simultaneous_highwater_next_step:
  kind state_sequence
  requirement "If methane is true, the system must set pump to false in the next step."
  trace:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
  expect:
    highwater=false, methane=false
    highwater=true, methane=true
    pump=false

test exhaustive_highwater_without_methane_bounded_response:
  kind eventually_response
  mode exhaustive
  max_depth 5
  max_paths 256
  requirement "If highwater is true and methane is false, the system must set pump to true in the next step."
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  eventually pump=true
  within_steps 2

test exhaustive_methane_bounded_response:
  kind eventually_response
  mode exhaustive
  max_depth 5
  max_paths 256
  requirement "If methane is true, the system must set pump to false in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false
  within_steps 2

test random_mixed_inputs_response_stress:
  kind eventually_response
  mode random
  runs 50
  max_depth 6
  seed 17
  requirement "The pump activates when water is high provided there is no methane, and deactivates in the next step whenever methane is present."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false
  within_steps 2
