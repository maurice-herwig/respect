{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "highwater_without_methane_turns_pump_on_next_step",
      "kind": "state_sequence",
      "requirement": "If highwater is true and methane is false, the system must set pump to true in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_turns_pump_off_next_step",
      "kind": "state_sequence",
      "requirement": "If methane is true, the system must set pump to false in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "methane_overrides_simultaneous_highwater_next_step",
      "kind": "state_sequence",
      "requirement": "If methane is true, the system must set pump to false in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "exhaustive_highwater_without_methane_bounded_response",
      "kind": "eventually_response",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 256,
      "requirement": "If highwater is true and methane is false, the system must set pump to true in the next step.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      },
      "within_steps": 2
    },
    {
      "name": "exhaustive_methane_bounded_response",
      "kind": "eventually_response",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 256,
      "requirement": "If methane is true, the system must set pump to false in the next step.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "eventually": {
        "pump": "false"
      },
      "within_steps": 2
    },
    {
      "name": "random_mixed_inputs_response_stress",
      "kind": "eventually_response",
      "mode": "random",
      "runs": 50,
      "max_depth": 6,
      "seed": 17,
      "requirement": "The pump activates when water is high provided there is no methane, and deactivates in the next step whenever methane is present.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "eventually": {
        "pump": "false"
      },
      "within_steps": 2
    }
  ],
