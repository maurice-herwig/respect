controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed84\model=qwen3\cef9d139a3b7340793ccdcbb\branches\self_test\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed84\model=qwen3\cef9d139a3b7340793ccdcbb\branches\self_test\specs\00_from_core.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership

test pump_after_highwater_without_methane:
  kind state_sequence
  requirement "If highwater is true and methane is false, the system must set pump to true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
  expect:
    highwater=true, methane=false
    pump=true

test pump_after_methane:
  kind state_sequence
  requirement "If methane is true, the system must set pump to false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    highwater=false, methane=true
    pump=false
