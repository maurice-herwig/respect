controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped2_fixed27\model=qwen3\ebb3f64a8a43d2418a87d9d4\branches\self_test\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped2_fixed27\model=qwen3\ebb3f64a8a43d2418a87d9d4\branches\self_test\specs\00_from_core.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership

test safe_highwater_turns_pump_on_next_step:
  kind state_sequence
  requirement "If methane is not present and the water level is high, the pump must be set to true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
  expect:
    highwater=true, methane=false
    pump=true

test methane_turns_pump_off_next_step:
  kind state_sequence
  requirement "If methane is present, the pump must be set to false in the next step."
  trace:
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    highwater=true, methane=true
    pump=false
