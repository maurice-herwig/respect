{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "water_without_methane_pump_next",
      "kind": "state_sequence",
      "requirement": "If methane is false and highwater is true, then pump must be true in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_pump_off_next",
      "kind": "state_sequence",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "alternating_triggers_next_step",
      "kind": "state_sequence",
      "requirement": "At every step, either methane is true, or pump will be true in the next step, or highwater is false; and if methane is true, pump will be false in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "exhaustive_no_methane_highwater_response",
      "kind": "eventually_response",
      "mode": "exhaustive",
      "requirement": "If methane is false and highwater is true, then pump must be true in the next step.",
      "max_depth": 5,
      "max_paths": 128,
      "within_steps": 2,
      "require_closed_obligations": true,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      }
    },
    {
      "name": "exhaustive_methane_response_absence",
      "kind": "eventually_response",
      "mode": "exhaustive",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "max_depth": 5,
      "max_paths": 128,
      "within_steps": 2,
      "require_closed_obligations": true,
      "env": {
        "highwater": [
          "false"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "eventually": {
        "pump": "false"
      }
    },
    {
      "name": "random_assumption_compatible_stress",
      "kind": "eventually_response",
      "mode": "random",
      "requirement": "If methane is false and highwater is true, then pump must be true in the next step.",
      "runs": 30,
      "max_depth": 6,
      "seed": 96,
      "within_steps": 2,
      "require_closed_obligations": true,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      }
    }
  ],
