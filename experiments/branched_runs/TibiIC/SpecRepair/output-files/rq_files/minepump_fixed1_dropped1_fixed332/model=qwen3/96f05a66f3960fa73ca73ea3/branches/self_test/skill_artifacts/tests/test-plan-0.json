{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "highwater_without_methane_turns_pump_on_next",
      "kind": "state_sequence",
      "requirement": "If methane is false and highwater is true, then pump must be true in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_turns_pump_off_next",
      "kind": "state_sequence",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "pump": "false"
        }
      ]
    }
  ],
