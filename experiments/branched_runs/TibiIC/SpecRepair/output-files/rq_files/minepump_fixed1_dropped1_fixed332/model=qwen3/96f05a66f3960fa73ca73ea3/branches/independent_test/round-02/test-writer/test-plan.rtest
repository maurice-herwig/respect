controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed332\model=qwen3\96f05a66f3960fa73ca73ea3\branches\independent_test\round-01\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed332\model=qwen3\96f05a66f3960fa73ca73ea3\branches\independent_test\round-01\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test water_without_methane_pump_next:
  kind state_sequence
  requirement "If methane is false and highwater is true, then pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
  expect:
    highwater=true, methane=false
    pump=true
    pump=true

test methane_pump_off_next:
  kind state_sequence
  requirement "If methane is true, then pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=true, methane=false
  expect:
    highwater=false, methane=true
    pump=false
    pump=true

test alternating_triggers_next_step:
  kind state_sequence
  requirement "At every step, either methane is true, or pump will be true in the next step, or highwater is false; and if methane is true, pump will be false in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
  expect:
    highwater=true, methane=false
    pump=true
    pump=false
    pump=true
    pump=false

test exhaustive_no_methane_highwater_response:
  kind eventually_response
  mode exhaustive
  requirement "If methane is false and highwater is true, then pump must be true in the next step."
  max_depth 5
  max_paths 128
  within_steps 2
  require_closed_obligations true
  domains:
    highwater false, true
    methane false
  when highwater=true, methane=false
  eventually pump=true

test exhaustive_methane_response_absence:
  kind eventually_response
  mode exhaustive
  requirement "If methane is true, then pump must be false in the next step."
  max_depth 5
  max_paths 128
  within_steps 2
  require_closed_obligations true
  domains:
    highwater false
    methane false, true
  when methane=true
  eventually pump=false

test random_assumption_compatible_stress:
  kind eventually_response
  mode random
  requirement "If methane is false and highwater is true, then pump must be true in the next step."
  runs 30
  max_depth 6
  seed 96
  within_steps 2
  require_closed_obligations true
  domains:
    highwater false, true
    methane false
  when highwater=true, methane=false
  eventually pump=true
