controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\independent_test\round-02\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\independent_test\round-02\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_forces_pump_off_next_step:
  kind state_sequence
  requirement "At every step, if methane is true, then the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    pump=false
    pump=false
    pump=false

test highwater_without_methane_forces_pump_on_next_step:
  kind state_sequence
  requirement "At every step, if methane is false and highwater is true, then the pump must be true in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
  expect:
    pump=false
    pump=true
    pump=false

test alternating_hazard_and_water_conditions:
  kind state_sequence
  requirement "The pump turns off whenever methane is detected and turns on whenever the water level is high provided no methane is present."
  trace:
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
  expect:
    pump=false
    pump=true
    pump=false
    pump=true
    pump=false

test methane_overrides_highwater:
  kind state_sequence
  requirement "At every step, if methane is true, then the pump must be false in the next step."
  trace:
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=false, methane=false
    highwater=true, methane=true
  expect:
    pump=false
    pump=false
    pump=false
    pump=false

test repeated_valid_pump_activation_cycles:
  kind state_sequence
  requirement "At every step, if methane is false and highwater is true, then the pump must be true in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
  expect:
    pump=false
    pump=true
    pump=false
    pump=true
    pump=false
