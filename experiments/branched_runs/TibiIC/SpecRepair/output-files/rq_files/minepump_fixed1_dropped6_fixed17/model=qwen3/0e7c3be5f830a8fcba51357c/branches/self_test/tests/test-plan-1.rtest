controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\self_test\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\self_test\specs\00_from_core.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership

test methane_true_turns_pump_off_next:
  kind state_sequence
  requirement "At every step, if methane is true, then the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
  expect:
    highwater=false, methane=true
    highwater=false, methane=true, pump=false

test highwater_without_methane_turns_pump_on_next:
  kind state_sequence
  requirement "At every step, if methane is false and highwater is true, then the pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
  expect:
    highwater=true, methane=false
    highwater=false, methane=true, pump=true

test methane_after_forced_pump_on_turns_pump_off_next:
  kind state_sequence
  requirement "The pump turns off whenever methane is detected."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=false, methane=true
  expect:
    highwater=true, methane=false
    highwater=false, methane=true, pump=true
    highwater=false, methane=true, pump=false
