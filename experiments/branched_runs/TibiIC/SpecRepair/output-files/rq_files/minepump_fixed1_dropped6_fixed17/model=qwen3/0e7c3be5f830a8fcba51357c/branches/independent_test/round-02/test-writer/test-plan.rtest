controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\independent_test\round-01\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\independent_test\round-01\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_forces_next_pump_off:
  kind state_sequence
  requirement "At every step, if methane is true, then the pump must be false in the next step."
  trace:
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    methane=true
    pump=false
    pump=false

test highwater_without_methane_forces_next_pump_on:
  kind state_sequence
  requirement "At every step, if methane is false and highwater is true, then the pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=false, methane=true
  expect:
    methane=false, highwater=true
    pump=true
    pump=false

test methane_overrides_highwater_next_step:
  kind state_sequence
  requirement "The pump turns off whenever methane is detected and turns on whenever the water level is high provided no methane is present."
  trace:
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=false, methane=true
  expect:
    methane=true, highwater=true
    pump=false
    pump=true
    pump=false

test alternating_safe_and_unsafe_conditions:
  kind state_sequence
  requirement "If methane is true, the pump must be false in the next step; if methane is false and highwater is true, the pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
  expect:
    highwater=true, methane=false
    pump=true
    pump=false
    pump=true
    pump=false
    pump=true

test no_spurious_off_after_persistent_highwater_without_methane:
  kind state_sequence
  requirement "If methane is false and highwater is true, then the pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=false
    highwater=true, methane=false
    highwater=true, methane=false
  expect:
    highwater=true, methane=false
    pump=true
    pump=true
    pump=true

test persistent_methane_keeps_next_pump_off:
  kind state_sequence
  requirement "If methane is true, then the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    methane=true
    pump=false
    pump=false
    pump=false
