controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\independent_test\round-00\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped6_fixed17\model=qwen3\0e7c3be5f830a8fcba51357c\branches\independent_test\round-00\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_turns_pump_off_next_step:
  kind state_sequence
  requirement "At every step, if methane is true, then the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    pump=false
    pump=false

test methane_overrides_highwater_next_step:
  kind state_sequence
  requirement "The pump turns off whenever methane is detected, even when the water level is high."
  trace:
    highwater=true, methane=true
    highwater=true, methane=false
  expect:
    pump=false
    pump=false

test highwater_without_methane_turns_pump_on_next_step:
  kind state_sequence
  requirement "If methane is false and highwater is true, then the pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=false
  expect:
    pump=false
    pump=true

test alternating_safe_and_unsafe_inputs:
  kind state_sequence
  requirement "The pump turns off whenever methane is detected and turns on whenever highwater is true provided no methane is present."
  trace:
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
  expect:
    pump=false
    pump=true
    pump=false
    pump=true
    pump=false

test persistent_methane_keeps_next_pump_off:
  kind state_sequence
  requirement "At every step, if methane is true, then the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
  expect:
    pump=false
    pump=false
    pump=false
    pump=false

test bounded_input_stress_no_pump_during_methane:
  kind always_implication
  mode exhaustive
  max_depth 5
  max_paths 256
  requirement "The pump turns off whenever methane is detected."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  then pump=false

test bounded_input_stress_highwater_without_methane_pump_on:
  kind always_implication
  mode exhaustive
  max_depth 5
  max_paths 256
  requirement "If methane is false and highwater is true, then the pump must be true in the next step."
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  then pump=true
