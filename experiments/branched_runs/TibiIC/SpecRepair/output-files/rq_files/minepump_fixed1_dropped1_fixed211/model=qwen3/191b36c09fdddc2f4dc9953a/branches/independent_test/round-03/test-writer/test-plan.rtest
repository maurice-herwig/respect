controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\independent_test\round-02\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\independent_test\round-02\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_absent_eventually_turns_pump_on_lowwater:
  kind eventually_response
  requirement "If methane is false, the system must turn the pump on in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true

test methane_present_eventually_turns_pump_off_lowwater:
  kind eventually_response
  requirement "If methane is true, the system must turn the pump off in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 2
  require_closed_obligations true

test methane_absent_eventually_turns_pump_on_after_highwater_drop:
  kind eventually_response
  requirement "If methane is false, the system must turn the pump on in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true

test methane_present_eventually_turns_pump_off_during_highwater:
  kind eventually_response
  requirement "If methane is true, the system must turn the pump off in the next step."
  trace:
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 2
  require_closed_obligations true

test alternating_methane_drives_pump_to_matching_next_state:
  kind state_sequence
  requirement "If methane is false the pump must be true in the next step, and if methane is true the pump must be false in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    pump=true
    pump=false
    pump=true
    pump=false
    pump=true

test exhaustive_methane_false_requires_pump_on:
  kind eventually_response
  mode exhaustive
  requirement "If methane is false, the system must turn the pump on in the next step."
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true

test exhaustive_methane_true_requires_pump_off:
  kind eventually_response
  mode exhaustive
  requirement "If methane is true, the system must turn the pump off in the next step."
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false
  within_steps 2
  require_closed_obligations true
