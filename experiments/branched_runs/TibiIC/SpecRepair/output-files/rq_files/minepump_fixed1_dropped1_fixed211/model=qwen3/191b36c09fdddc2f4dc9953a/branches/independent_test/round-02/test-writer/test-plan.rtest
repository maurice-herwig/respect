controller_dir "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\independent_test\round-01\spec-repair\synthesis\jit"
spec_name Minepump
spectra_file "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\independent_test\round-01\spec-repair\skill_artifacts\final.spectra"
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_absent_turns_pump_on_persistent_lowwater:
  kind state_sequence
  requirement "If methane is false, the system must turn the pump on in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  expect:
    pump=true
    pump=true
    pump=true
    pump=true

test methane_present_turns_pump_off_with_highwater_changes:
  kind state_sequence
  requirement "If methane is true, the system must turn the pump off in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
  expect:
    pump=false
    pump=false
    pump=false
    pump=false

test alternating_methane_controls_pump:
  kind state_sequence
  requirement "If methane is false, the system must turn the pump on in the next step; if methane is true, the system must turn the pump off in the next step."
  trace:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
  expect:
    pump=true
    pump=false
    pump=true
    pump=false
    pump=true
    pump=false

test methane_absent_bounded_response:
  kind eventually_response
  requirement "Either methane is true or the pump must be true in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true

test methane_present_bounded_response:
  kind eventually_response
  requirement "Either methane is false or the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 2
  require_closed_obligations true

test no_pump_while_methane_present:
  kind response_absence
  requirement "If methane is true, the system must turn the pump off in the next step."
  trace:
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
  when methane=true
  absent pump=true
  for_steps 2
