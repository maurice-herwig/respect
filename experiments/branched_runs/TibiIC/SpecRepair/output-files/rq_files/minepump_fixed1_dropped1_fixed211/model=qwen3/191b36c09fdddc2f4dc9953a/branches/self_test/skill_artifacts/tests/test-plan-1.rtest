controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\self_test\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\self_test\specs\00_from_core.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test no_methane_turns_pump_on_next:
  kind eventually_response
  requirement "If methane is false, the system must turn the pump on in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test methane_turns_pump_off_next:
  kind eventually_response
  requirement "If methane is true, the system must turn the pump off in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 1
  require_closed_obligations true

test pump_tracks_methane_changes:
  kind state_sequence
  requirement "The pump must be on in the next step after methane is false and off in the next step after methane is true."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
  expect:
    highwater=false, methane=false
    highwater=false, methane=true, pump=true
    highwater=false, methane=false, pump=false
    highwater=false, methane=true, pump=true
