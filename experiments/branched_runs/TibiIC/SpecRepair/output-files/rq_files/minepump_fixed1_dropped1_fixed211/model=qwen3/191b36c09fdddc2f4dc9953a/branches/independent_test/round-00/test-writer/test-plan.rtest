controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\core\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\core\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test initial_no_methane_turns_pump_on:
  kind initial_condition
  requirement "If methane is false, the system must turn the pump on in the next step."
  inputs highwater=false, methane=false
  expected pump=true

test initial_methane_turns_pump_off:
  kind initial_condition
  requirement "If methane is true, the system must turn the pump off in the next step."
  inputs highwater=false, methane=true
  expected pump=false

test no_methane_response_under_env_assumption:
  kind eventually_response
  requirement "Either methane is true or the pump must be true in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test methane_response_under_env_assumption:
  kind eventually_response
  requirement "Either methane is false or the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 1
  require_closed_obligations true

test alternating_methane_controls_next_pump:
  kind state_sequence
  requirement "If methane is false, the pump must be on in the next step; if methane is true, the pump must be off in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
  expect:
    pump=true
    pump=false
    pump=true
    pump=false
    pump=true
    pump=false

test exhaustive_methane_absent_implies_pump_on:
  kind always_implication
  mode exhaustive
  max_depth 1
  max_paths 4
  requirement "If methane is false, the system must turn the pump on in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=false
  then pump=true

test exhaustive_methane_present_implies_pump_off:
  kind always_implication
  mode exhaustive
  max_depth 1
  max_paths 4
  requirement "If methane is true, the system must turn the pump off in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  then pump=false

test random_highwater_variation_preserves_no_methane_response:
  kind eventually_response
  mode random
  runs 20
  max_depth 6
  seed 211
  requirement "If methane is false, the system must turn the pump on in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test random_highwater_variation_preserves_methane_response:
  kind eventually_response
  mode random
  runs 20
  max_depth 6
  seed 212
  requirement "If methane is true, the system must turn the pump off in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false
  within_steps 1
  require_closed_obligations true
