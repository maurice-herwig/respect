controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\independent_test\round-00\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed211\model=qwen3\191b36c09fdddc2f4dc9953a\branches\independent_test\round-00\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test initial_methane_absent_turns_pump_on:
  kind initial_condition
  requirement "If methane is false, the system must turn the pump on in the next step."
  inputs highwater=false, methane=false
  expected pump=true

test initial_methane_present_turns_pump_off:
  kind initial_condition
  requirement "If methane is true, the system must turn the pump off in the next step."
  inputs highwater=true, methane=true
  expected pump=false

test lowwater_absent_methane_requires_pump_on:
  kind always_implication
  requirement "Either methane is true or the pump must be true in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
  when methane=false
  then pump=true

test methane_present_requires_pump_off:
  kind always_implication
  requirement "Either methane is false or the pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=false, methane=false
  when methane=true
  then pump=false

test alternating_methane_tracks_pump:
  kind state_sequence
  requirement "If methane is false, the system must turn the pump on; if methane is true, the system must turn the pump off."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    pump=true
    pump=false
    pump=true
    pump=false
    pump=true

test exhaustive_lowwater_methane_absent_response:
  kind always_implication
  mode exhaustive
  requirement "If methane is false, the system must turn the pump on in the next step."
  max_depth 6
  max_paths 128
  domains:
    highwater false
    methane false, true
  when methane=false
  then pump=true

test exhaustive_methane_present_highwater_irrelevant_off:
  kind always_implication
  mode exhaustive
  requirement "If methane is true, the system must turn the pump off in the next step."
  max_depth 6
  max_paths 128
  domains:
    highwater false, true
    methane true
  when methane=true
  then pump=false
