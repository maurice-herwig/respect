controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed90\model=qwen3\1e780f632cd261857577b4ec\branches\independent_test\round-02\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped1_fixed90\model=qwen3\1e780f632cd261857577b4ec\branches\independent_test\round-02\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_false_persistent_requires_pump:
  kind eventually_response
  requirement "If methane is false, the system must ensure the pump is true in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test methane_true_persistent_requires_no_pump:
  kind eventually_response
  requirement "If methane is true, the system must ensure the pump is false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 1
  require_closed_obligations true

test methane_false_after_true_requires_pump:
  kind eventually_response
  requirement "At every step, either methane is true or the pump will be true in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
  when methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test methane_true_after_false_requires_no_pump:
  kind eventually_response
  requirement "At every step, either methane is false or the pump will be false in the next step."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=false, methane=true
  when methane=true
  eventually pump=false
  within_steps 1
  require_closed_obligations true

test exhaustive_methane_false_requires_pump:
  kind eventually_response
  mode exhaustive
  requirement "If methane is false, the system must ensure the pump is true in the next step."
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test exhaustive_methane_true_requires_no_pump:
  kind eventually_response
  mode exhaustive
  requirement "If methane is true, the system must ensure the pump is false in the next step."
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false
  within_steps 1
  require_closed_obligations true
