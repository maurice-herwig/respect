controller_dir "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped10_fixed21\model=qwen3\9694a6529aae08959ed819d9\core\synthesis\jit"
spec_name Minepump
spectra_file "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped10_fixed21\model=qwen3\9694a6529aae08959ed819d9\core\skill_artifacts\final.spectra"
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test persistent_no_methane_turns_pump_on:
  kind state_sequence
  requirement "Whenever methane is false, the system must set the pump to true in the subsequent state."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=true, methane=false
  expect:
    methane=false
    pump=true
    pump=true
    pump=true

test persistent_methane_turns_pump_off:
  kind state_sequence
  requirement "Whenever methane is true, the system must set the pump to false in the subsequent state."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=true, methane=true
  expect:
    methane=true
    pump=false
    pump=false
    pump=false

test alternating_from_no_methane_tracks_next_pump:
  kind state_sequence
  requirement "The next state of the pump is dictated by the current methane level."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    methane=false
    pump=true
    pump=false
    pump=true
    pump=false

test alternating_from_methane_tracks_next_pump:
  kind state_sequence
  requirement "The next state of the pump is dictated by the current methane level."
  trace:
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=true, methane=true
  expect:
    methane=true
    pump=false
    pump=true
    pump=false
    pump=true

test no_methane_response_within_one_step:
  kind eventually_response
  mode exhaustive
  requirement "Either methane is true, or the pump must be true in the next step."
  max_depth 5
  max_paths 64
  within_steps 1
  require_closed_obligations true
  domains:
    highwater false, true
    methane false, true
  when methane=false
  eventually pump=true

test methane_response_within_one_step:
  kind eventually_response
  mode exhaustive
  requirement "Either methane is false, or the pump must be false in the next step."
  max_depth 5
  max_paths 64
  within_steps 1
  require_closed_obligations true
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false

test highwater_does_not_override_no_methane:
  kind state_sequence
  requirement "The pump's next state is based on the current methane level; highwater is an environment input but no pump rule depends on it."
  trace:
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
  expect:
    methane=false
    pump=true
    pump=true
    pump=true

test highwater_does_not_override_methane:
  kind state_sequence
  requirement "The pump's next state is based on the current methane level; highwater is an environment input but no pump rule depends on it."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
  expect:
    methane=true
    pump=false
    pump=false
    pump=false
