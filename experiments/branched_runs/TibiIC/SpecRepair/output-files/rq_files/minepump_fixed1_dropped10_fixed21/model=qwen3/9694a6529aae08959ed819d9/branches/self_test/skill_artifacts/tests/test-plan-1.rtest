controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped10_fixed21\model=qwen3\9694a6529aae08959ed819d9\branches\self_test\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped10_fixed21\model=qwen3\9694a6529aae08959ed819d9\branches\self_test\specs\00_from_core.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership

test methane_false_then_pump_true_next:
  kind state_sequence
  requirement "Whenever methane is false, the system must set the pump to true in the subsequent state."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
  expect:
    methane=false
    pump=true

test methane_true_then_pump_false_next:
  kind state_sequence
  requirement "Whenever methane is true, the system must set the pump to false in the subsequent state."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
  expect:
    methane=true
    pump=false

test methane_alternation_next_outputs:
  kind state_sequence
  requirement "The pump's next state must be true after methane is false and false after methane is true."
  trace:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
    highwater=true, methane=true
  expect:
    methane=false
    pump=true
    pump=false
    pump=true
