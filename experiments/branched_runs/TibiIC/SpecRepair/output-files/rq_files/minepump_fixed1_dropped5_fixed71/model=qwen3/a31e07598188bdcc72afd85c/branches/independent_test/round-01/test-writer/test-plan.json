{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "exhaustive_methane_false_requires_pump_on",
      "kind": "always_implication",
      "requirement": "At every step, either methane is true or the pump will be true in the next state.",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 64,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "false"
      },
      "then": {
        "pump": "true"
      }
    },
    {
      "name": "exhaustive_methane_true_requires_pump_off",
      "kind": "always_implication",
      "requirement": "At every step, either methane is false or the pump will be false in the next state.",
      "mode": "exhaustive",
      "max_depth": 5,
      "max_paths": 64,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "then": {
        "pump": "false"
      }
    },
    {
      "name": "alternating_methane_controls_pump",
      "kind": "state_sequence",
      "requirement": "The pump's state in the next step is constrained by the current presence or absence of methane.",
      "trace": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        }
      ],
      "expect": [
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        },
        {
          "pump": "true"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "persistent_no_methane_keeps_pump_on",
      "kind": "state_sequence",
      "requirement": "At every step, either methane is true or the pump will be true in the next state.",
      "trace": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "pump": "true"
        },
        {
          "pump": "true"
        },
        {
          "pump": "true"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "persistent_methane_keeps_pump_off",
      "kind": "state_sequence",
      "requirement": "At every step, either methane is false or the pump will be false in the next state.",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "true"
        }
      ],
      "expect": [
        {
          "pump": "false"
        },
        {
          "pump": "false"
        },
        {
          "pump": "false"
        },
        {
          "pump": "false"
        }
      ]
    }
  ],
