controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped5_fixed71\model=qwen3\a31e07598188bdcc72afd85c\branches\independent_test\round-01\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped5_fixed71\model=qwen3\a31e07598188bdcc72afd85c\branches\independent_test\round-01\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_absent_next_pump_on_lowwater:
  kind state_sequence
  requirement "At every step, either methane is true or the pump will be true in the next state."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
  expect:
    highwater=false, methane=false
    pump=true

test methane_absent_next_pump_on_highwater:
  kind state_sequence
  requirement "At every step, either methane is true or the pump will be true in the next state."
  trace:
    highwater=true, methane=false
    highwater=true, methane=false
  expect:
    highwater=true, methane=false
    pump=true

test methane_present_next_pump_off_lowwater:
  kind state_sequence
  requirement "At every step, either methane is false or the pump will be false in the next state."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
  expect:
    highwater=false, methane=true
    pump=false

test methane_present_next_pump_off_highwater:
  kind state_sequence
  requirement "At every step, either methane is false or the pump will be false in the next state."
  trace:
    highwater=true, methane=true
    highwater=true, methane=true
  expect:
    highwater=true, methane=true
    pump=false

test alternating_methane_controls_next_pump:
  kind state_sequence
  requirement "The pump's state in the next step is constrained by the current presence or absence of methane."
  trace:
    highwater=false, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    highwater=false, methane=false
    pump=true
    pump=false
    pump=true
    pump=false

test rapid_highwater_changes_do_not_override_methane_absent:
  kind state_sequence
  requirement "At every step, either methane is true or the pump will be true in the next state."
  trace:
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
  expect:
    highwater=false, methane=false
    pump=true
    pump=true
    pump=true

test rapid_highwater_changes_do_not_override_methane_present:
  kind state_sequence
  requirement "At every step, either methane is false or the pump will be false in the next state."
  trace:
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
  expect:
    highwater=true, methane=true
    pump=false
    pump=false
    pump=false
