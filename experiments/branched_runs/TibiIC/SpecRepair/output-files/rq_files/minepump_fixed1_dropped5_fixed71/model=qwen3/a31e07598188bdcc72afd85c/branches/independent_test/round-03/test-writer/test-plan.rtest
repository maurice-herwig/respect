controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped5_fixed71\model=qwen3\a31e07598188bdcc72afd85c\branches\independent_test\round-02\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped5_fixed71\model=qwen3\a31e07598188bdcc72afd85c\branches\independent_test\round-02\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test exhaustive_no_methane_requires_pump:
  kind always_implication
  requirement "At every step, either methane is true or the pump will be true in the next state."
  mode exhaustive
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=false
  then pump=true

test exhaustive_methane_requires_pump_off:
  kind always_implication
  requirement "At every step, either methane is false or the pump will be false in the next state."
  mode exhaustive
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=true
  then pump=false

test alternating_methane_tracks_pump:
  kind state_sequence
  requirement "The pump's state in the next step is constrained by the current presence or absence of methane."
  trace:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
  expect:
    pump=true
    pump=false
    pump=true
    pump=true
    pump=false
    pump=true

test persistent_methane_keeps_pump_off:
  kind exclusion
  requirement "At every step, either methane is false or the pump will be false in the next state."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
  forbidden methane=true, pump=true

test persistent_no_methane_keeps_pump_on:
  kind exclusion
  requirement "At every step, either methane is true or the pump will be true in the next state."
  trace:
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
  forbidden methane=false, pump=false

test random_methane_absent_never_pump_off:
  kind exclusion
  requirement "At every step, either methane is true or the pump will be true in the next state."
  mode random
  runs 50
  max_depth 6
  seed 71
  domains:
    highwater false, true
    methane false, true
  forbidden methane=false, pump=false

test random_methane_present_never_pump_on:
  kind exclusion
  requirement "At every step, either methane is false or the pump will be false in the next state."
  mode random
  runs 50
  max_depth 6
  seed 72
  domains:
    highwater false, true
    methane false, true
  forbidden methane=true, pump=true
