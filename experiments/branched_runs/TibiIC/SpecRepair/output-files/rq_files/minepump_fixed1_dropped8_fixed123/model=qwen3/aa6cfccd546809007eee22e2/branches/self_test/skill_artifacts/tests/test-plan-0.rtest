environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  requirement "The environment controls highwater and methane, and the system controls pump."

test highwater_methane_forces_next_pump_off:
  kind state_sequence
  requirement "If both highwater and methane are true, the system must ensure that pump is off in the next step."
  trace:
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    highwater=true, methane=true
    pump=false
