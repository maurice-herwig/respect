controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped8_fixed123\model=qwen3\aa6cfccd546809007eee22e2\core\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\rq_files\minepump_fixed1_dropped8_fixed123\model=qwen3\aa6cfccd546809007eee22e2\core\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test simultaneous_highwater_methane_turns_pump_off_next:
  kind state_sequence
  requirement "If both the highwater and methane inputs are true, the system must ensure that the pump is off in the next step."
  trace:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=false, methane=false, pump=false

test sustained_highwater_methane_keeps_pump_off_after_first_response:
  kind state_sequence
  requirement "If both the highwater and methane inputs are true, the system must ensure that the pump is off in the next step."
  trace:
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=true, methane=true
  expect:
    highwater=true, methane=true
    highwater=true, methane=true, pump=false
    highwater=true, methane=true, pump=false
    highwater=true, methane=true, pump=false

test methane_arrival_while_highwater_forces_next_off:
  kind state_sequence
  requirement "If both the highwater and methane inputs are true, the system must ensure that the pump is off in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
  expect:
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=true, methane=false, pump=false

test highwater_arrival_while_methane_forces_next_off:
  kind state_sequence
  requirement "If both the highwater and methane inputs are true, the system must ensure that the pump is off in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
  expect:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=false, methane=true, pump=false
