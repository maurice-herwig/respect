controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\dropped\minepump_fixed1_normalised_dropped8\model=qwen3\2bbcf860ee2205e5ad577beb\core\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\output-files\dropped\minepump_fixed1_normalised_dropped8\model=qwen3\2bbcf860ee2205e5ad577beb\core\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test initial_pump_false_no_hazard:
  kind initial_condition
  requirement "The pump variable is assumed to be false at all times."
  inputs highwater=false, methane=false
  expected pump=false

test exhaustive_pump_false_all_inputs:
  kind invariant
  requirement "The pump variable is assumed to be false at all times."
  mode exhaustive
  max_depth 6
  max_paths 256
  domains:
    highwater false, true
    methane false, true
  condition pump=false

test no_highwater_without_methane_exhaustive:
  kind exclusion
  requirement "At all times, either methane is true or highwater is false."
  mode exhaustive
  max_depth 6
  max_paths 256
  domains:
    highwater false, true
    methane false, true
  forbidden highwater=true, methane=false

test no_highwater_without_methane_concrete_stress:
  kind exclusion
  requirement "At all times, either methane is true or highwater is false."
  trace:
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
  forbidden highwater=true, methane=false

test methane_next_pump_false_when_methane_clears:
  kind state_sequence
  requirement "At all times, if methane is true, then pump must be false in the next state."
  trace:
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    methane=true
    pump=false

test methane_next_pump_false_when_methane_persists:
  kind state_sequence
  requirement "At all times, if methane is true, then pump must be false in the next state."
  trace:
    highwater=true, methane=true
    highwater=false, methane=true
  expect:
    methane=true
    pump=false
