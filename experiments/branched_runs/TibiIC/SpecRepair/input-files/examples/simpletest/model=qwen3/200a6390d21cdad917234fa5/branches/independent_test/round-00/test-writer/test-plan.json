{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "input1",
        "input2"
      ],
      "sys": [
        "output1",
        "output2"
      ]
    },
    {
      "name": "initially_outputs_true_when_inputs_satisfy_assumption",
      "kind": "initial_condition",
      "requirement": "Provided the environment satisfies these assumptions, output1 and output2 must be true at all times.",
      "inputs": {
        "input1": "true",
        "input2": "true"
      },
      "expected": {
        "output1": "true",
        "output2": "true"
      }
    },
    {
      "name": "outputs_always_true_with_input2_persistent_true",
      "kind": "invariant",
      "requirement": "The system must ensure that output1 is true at all times and output2 is true at all times.",
      "trace": [
        {
          "input1": "true",
          "input2": "true"
        },
        {
          "input1": "true",
          "input2": "true"
        },
        {
          "input1": "true",
          "input2": "true"
        },
        {
          "input1": "true",
          "input2": "true"
        }
      ],
      "condition": {
        "output1": "true",
        "output2": "true"
      }
    },
    {
      "name": "outputs_always_true_with_input2_alternating",
      "kind": "invariant",
      "requirement": "input2 must be true infinitely often; provided this assumption holds, output1 and output2 must be true at all times.",
      "trace": [
        {
          "input1": "true",
          "input2": "true"
        },
        {
          "input1": "true",
          "input2": "false"
        },
        {
          "input1": "true",
          "input2": "true"
        },
        {
          "input1": "true",
          "input2": "false"
        },
        {
          "input1": "true",
          "input2": "true"
        },
        {
          "input1": "true",
          "input2": "false"
        }
      ],
      "condition": {
        "output1": "true",
        "output2": "true"
      }
    },
    {
      "name": "output1_true_exhaustive_compliant_prefixes",
      "kind": "always_implication",
      "mode": "exhaustive",
      "requirement": "First, input1 must be true at all times; provided the environment satisfies this assumption, output1 must be true at all times.",
      "max_depth": 6,
      "max_paths": 64,
      "env": {
        "input1": [
          "true"
        ],
        "input2": [
          "false",
          "true"
        ]
      },
      "when": {
        "input1": "true"
      },
      "then": {
        "output1": "true"
      }
    },
    {
      "name": "output2_true_exhaustive_compliant_prefixes",
      "kind": "always_implication",
      "mode": "exhaustive",
      "requirement": "First, input1 must be true at all times; provided the environment satisfies this assumption, output2 must be true at all times.",
      "max_depth": 6,
      "max_paths": 64,
      "env": {
        "input1": [
          "true"
        ],
        "input2": [
          "false",
          "true"
        ]
      },
      "when": {
        "input1": "true"
      },
      "then": {
        "output2": "true"
      }
    },
    {
      "name": "outputs_never_false_random_compliant_prefixes",
      "kind": "exclusion",
      "mode": "random",
      "requirement": "The system must ensure that output1 is true at all times and output2 is true at all times.",
      "runs": 50,
      "max_depth": 6,
      "seed": 7,
      "env": {
        "input1": [
          "true"
        ],
        "input2": [
          "false",
          "true"
        ]
      },
      "forbidden": {
        "output1": "false"
      }
    },
    {
      "name": "output2_never_false_random_compliant_prefixes",
      "kind": "exclusion",
      "mode": "random",
      "requirement": "The system must ensure that output2 is true at all times.",
      "runs": 50,
      "max_depth": 6,
      "seed": 11,
      "env": {
        "input1": [
          "true"
        ],
        "input2": [
          "false",
          "true"
        ]
      },
      "forbidden": {
        "output2": "false"
      }
    }
  ],
  "controller_dir": "C:\\Users\\mauri\\OneDrive\\Desktop\\Repos\\respect\\experiments\\branched_runs\\TibiIC\\SpecRepair\\input-files\\examples\\simpletest\\model=qwen3\\200a6390d21cdad917234fa5\\core\\synthesis\\jit",
  "spec_name": "simpletest",
  "spectra_file": "C:\\Users\\mauri\\OneDrive\\Desktop\\Repos\\respect\\experiments\\branched_runs\\TibiIC\\SpecRepair\\input-files\\examples\\simpletest\\model=qwen3\\200a6390d21cdad917234fa5\\core\\skill_artifacts\\final.spectra",
  "environment": [
    "input1",
    "input2"
  ],
  "system": [
    "output1",
    "output2"
  ],
  "outputs": [
    "output1",
    "output2"
  ]
}
