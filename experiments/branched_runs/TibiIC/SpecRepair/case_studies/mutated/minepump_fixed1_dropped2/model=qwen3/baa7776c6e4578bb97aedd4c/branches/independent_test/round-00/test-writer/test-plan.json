{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "exhaustive_no_consecutive_pump_on",
      "kind": "response_absence",
      "mode": "exhaustive",
      "max_depth": 6,
      "max_paths": 256,
      "requirement": "The pump is never on for two consecutive steps; either the pump is currently off or it was off in the previous step.",
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "pump": "true"
      },
      "absent": {
        "pump": "true"
      },
      "for_steps": 1
    },
    {
      "name": "highwater_without_methane_pump_next",
      "kind": "eventually_response",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "requirement": "Whenever methane is false and highwater is true, the pump must be on in the next step.",
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      },
      "within_steps": 1,
      "require_closed_obligations": true
    },
    {
      "name": "methane_forces_pump_off_next",
      "kind": "eventually_response",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "true"
        }
      ],
      "requirement": "Whenever methane is true, the pump must be off in the next step.",
      "when": {
        "methane": "true"
      },
      "eventually": {
        "pump": "false"
      },
      "within_steps": 1,
      "require_closed_obligations": true
    },
    {
      "name": "methane_overrides_highwater",
      "kind": "eventually_response",
      "trace": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "requirement": "Whenever methane is true, the pump must be off in the next step.",
      "when": {
        "highwater": "true",
        "methane": "true"
      },
      "eventually": {
        "pump": "false"
      },
      "within_steps": 1,
      "require_closed_obligations": true
    },
    {
      "name": "alternating_inputs_keep_required_next_pump_values",
      "kind": "state_sequence",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        }
      ],
      "requirement": "The next pump state must be on after highwater without methane and off after methane.",
      "expect": [
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        },
        {
          "pump": "false"
        },
        {
          "pump": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
