controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped2\model=qwen3\baa7776c6e4578bb97aedd4c\branches\independent_test\round-00\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped2\model=qwen3\baa7776c6e4578bb97aedd4c\branches\independent_test\round-00\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_forces_pump_off_exhaustive:
  kind always_implication
  requirement "Whenever methane is true, the pump must be off in the next step."
  mode exhaustive
  max_depth 5
  max_paths 256
  domains:
    highwater false, true
    methane false, true
  when methane=true
  then pump=false

test highwater_without_methane_turns_pump_on_exhaustive:
  kind always_implication
  requirement "Whenever methane is false and highwater is true, the pump must be on in the next step."
  mode exhaustive
  max_depth 5
  max_paths 256
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  then pump=true

test persistent_methane_keeps_pump_off:
  kind state_sequence
  requirement "Whenever methane is true, the pump must be off in the next step."
  trace:
    highwater=false, methane=true
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
  expect:
    pump=false
    pump=false
    pump=false
    pump=false

test alternating_highwater_no_methane_requests_pump:
  kind eventually_response
  requirement "Whenever methane is false and highwater is true, the pump must be on in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=false, methane=true
  when highwater=true, methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true

test methane_overrides_highwater_on_switch:
  kind state_sequence
  requirement "Whenever methane is true, the pump must be off in the next step."
  trace:
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=true, methane=false
    highwater=true, methane=true
  expect:
    pump=true
    pump=false
    pump=true
    pump=false
