controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped2\model=qwen3\baa7776c6e4578bb97aedd4c\branches\independent_test\round-02\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped2\model=qwen3\baa7776c6e4578bb97aedd4c\branches\independent_test\round-02\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test highwater_without_methane_turns_pump_on_next:
  kind state_sequence
  requirement "Whenever methane is false and highwater is true, the pump must be on in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
  expect:
    highwater=true, methane=false
    pump=true

test methane_turns_pump_off_next:
  kind state_sequence
  requirement "Whenever methane is true, the pump must be off in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=false
  expect:
    highwater=false, methane=true
    pump=false

test methane_overrides_highwater_next:
  kind state_sequence
  requirement "Whenever methane is true, the pump must be off in the next step."
  trace:
    highwater=true, methane=true
    highwater=true, methane=false
  expect:
    highwater=true, methane=true
    pump=false

test pump_not_on_for_two_consecutive_steps_after_activation:
  kind state_sequence
  requirement "At any point in time, either the pump is currently off or it was off in the previous step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  expect:
    highwater=true, methane=false
    pump=true
    pump=false

test methane_absence_of_pump_bounded_random:
  kind eventually_response
  mode random
  requirement "Whenever methane is true, the pump must be off in the next step."
  runs 40
  max_depth 6
  seed 17
  domains:
    highwater false, true
    methane false, true
  when methane=true
  eventually pump=false
  within_steps 2
  require_closed_obligations true

test highwater_response_bounded_exhaustive:
  kind eventually_response
  mode exhaustive
  requirement "Whenever methane is false and highwater is true, the pump must be on in the next step."
  max_depth 5
  max_paths 256
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  eventually pump=true
  within_steps 2
  require_closed_obligations true
