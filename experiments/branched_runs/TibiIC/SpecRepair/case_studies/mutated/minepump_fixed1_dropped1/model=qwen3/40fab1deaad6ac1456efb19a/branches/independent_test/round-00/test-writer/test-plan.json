{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "methane_forces_pump_off_next_step",
      "kind": "state_sequence",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "methane": "true"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "methane_overrides_simultaneous_highwater_next_step",
      "kind": "state_sequence",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "pump": "false"
        }
      ]
    },
    {
      "name": "safe_highwater_turns_pump_on_next_step",
      "kind": "state_sequence",
      "requirement": "If highwater is true and methane is false, then pump must be true in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "repeated_safe_highwater_keeps_requesting_pump_next_step",
      "kind": "state_sequence",
      "requirement": "If highwater is true and methane is false, then pump must be true in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "alternating_safe_water_and_methane_next_step",
      "kind": "state_sequence",
      "requirement": "Pump activates to clear water when safe and deactivates when methane is detected.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        },
        {
          "methane": "true"
        },
        {
          "pump": "false"
        },
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "pump": "true"
        }
      ]
    },
    {
      "name": "exhaustive_methane_requires_next_absence_of_pump",
      "kind": "response_absence",
      "mode": "exhaustive",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "max_depth": 5,
      "max_paths": 64,
      "for_steps": 1,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "methane": "true"
      },
      "absent": {
        "pump": "true"
      }
    },
    {
      "name": "exhaustive_safe_highwater_gets_pump_response",
      "kind": "eventually_response",
      "mode": "exhaustive",
      "requirement": "If highwater is true and methane is false, then pump must be true in the next step.",
      "max_depth": 5,
      "max_paths": 64,
      "within_steps": 1,
      "require_closed_obligations": true,
      "env": {
        "highwater": [
          "false",
          "true"
        ],
        "methane": [
          "false",
          "true"
        ]
      },
      "when": {
        "highwater": "true",
        "methane": "false"
      },
      "eventually": {
        "pump": "true"
      }
    }
