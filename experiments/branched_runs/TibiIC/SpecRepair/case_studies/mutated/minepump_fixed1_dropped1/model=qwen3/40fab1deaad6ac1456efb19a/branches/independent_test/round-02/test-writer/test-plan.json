      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "methane_forces_pump_off_next_trace",
      "kind": "state_sequence",
      "requirement": "If methane is true, then pump must be false in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "pump": "false"
        },
        {
          "pump": "false"
        },
        {
          "pump": "false"
        }
      ]
    },
