controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped1\model=qwen3\40fab1deaad6ac1456efb19a\branches\independent_test\round-01\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped1\model=qwen3\40fab1deaad6ac1456efb19a\branches\independent_test\round-01\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_forces_pump_off:
  kind always_implication
  requirement "If methane is true, then pump must be false in the next step."
  trace:
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
  when methane=true
  then pump=false

test highwater_without_methane_turns_pump_on:
  kind eventually_response
  requirement "If highwater is true and methane is false, then pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  when highwater=true, methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test methane_overrides_highwater:
  kind always_implication
  requirement "If methane is true, then pump must be false in the next step, even when highwater is also true."
  trace:
    highwater=true, methane=true
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=false, methane=false
  when methane=true
  then pump=false

test safe_highwater_repeated_after_clear:
  kind eventually_response
  requirement "The pump activates to clear water when highwater is true and methane is false."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
    highwater=false, methane=false
  when highwater=true, methane=false
  eventually pump=true
  within_steps 1
  require_closed_obligations true

test methane_blocks_after_safe_request:
  kind always_implication
  requirement "The pump deactivates when methane is detected."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=false, methane=true
    highwater=false, methane=false
  when methane=true
  then pump=false
