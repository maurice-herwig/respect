{
  "tests": [
    {
      "name": "declared_variables",
      "kind": "variable_ownership",
      "env": [
        "highwater",
        "methane"
      ],
      "sys": [
        "pump"
      ]
    },
    {
      "name": "methane_stops_pump_next",
      "kind": "state_sequence",
      "requirement": "At all times, if methane is true, then pump must be false in the next step.",
      "trace": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "false",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false",
          "pump": "false"
        }
      ]
    },
    {
      "name": "safe_highwater_starts_pump_next",
      "kind": "state_sequence",
      "requirement": "At all times, if highwater is true and methane is false, then pump must be true in the next step.",
      "trace": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "false"
        },
        {
          "highwater": "false",
          "methane": "false",
          "pump": "true"
        }
      ]
    },
    {
      "name": "methane_priority_when_highwater",
      "kind": "state_sequence",
      "requirement": "At all times, if methane is true, then pump must be false in the next step, even when highwater is also true.",
      "trace": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false"
        }
      ],
      "expect": [
        {
          "highwater": "true",
          "methane": "true"
        },
        {
          "highwater": "false",
          "methane": "false",
          "pump": "false"
        }
      ]
    }
  ],
