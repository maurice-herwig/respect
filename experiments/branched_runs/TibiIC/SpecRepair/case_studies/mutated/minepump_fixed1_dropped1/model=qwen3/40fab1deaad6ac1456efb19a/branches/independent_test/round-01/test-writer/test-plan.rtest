controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped1\model=qwen3\40fab1deaad6ac1456efb19a\branches\independent_test\round-00\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped1\model=qwen3\40fab1deaad6ac1456efb19a\branches\independent_test\round-00\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_forces_pump_off_exhaustive:
  kind always_implication
  requirement "If methane is true, then pump must be false in the next step."
  mode exhaustive
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when methane=true
  then pump=false

test highwater_without_methane_forces_pump_on_exhaustive:
  kind always_implication
  requirement "If highwater is true and methane is false, then pump must be true in the next step."
  mode exhaustive
  max_depth 5
  max_paths 64
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  then pump=true

test methane_priority_over_highwater_trace:
  kind state_sequence
  requirement "If methane is true, then pump must be false in the next step."
  trace:
    highwater=true, methane=true
    highwater=false, methane=true
    highwater=true, methane=true
  expect:
    pump=false
    pump=false
    pump=false

test safe_highwater_activation_trace:
  kind state_sequence
  requirement "If highwater is true and methane is false, then pump must be true in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=false
    highwater=true, methane=false
  expect:
    pump=true
    pump=false
    pump=true

test no_highwater_no_methane_does_not_force_pump:
  kind response_absence
  requirement "The pump activates to clear water when highwater is true and methane is false."
  trace:
    highwater=false, methane=false
    highwater=false, methane=false
    highwater=false, methane=false
  absent pump=true
  for_steps 3

test alternating_inputs_respect_immediate_rules:
  kind state_sequence
  requirement "The pump activates to clear water when safe and deactivates when methane is detected."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
    highwater=true, methane=false
    highwater=true, methane=true
    highwater=false, methane=false
  expect:
    pump=true
    pump=false
    pump=true
    pump=false
    pump=false
