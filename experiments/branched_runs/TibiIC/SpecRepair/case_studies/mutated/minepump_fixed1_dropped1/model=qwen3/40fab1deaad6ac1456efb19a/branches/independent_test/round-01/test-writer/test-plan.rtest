controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped1\model=qwen3\40fab1deaad6ac1456efb19a\branches\independent_test\round-00\spec-repair\synthesis\jit
spec_name Minepump
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\TibiIC\SpecRepair\case_studies\mutated\minepump_fixed1_dropped1\model=qwen3\40fab1deaad6ac1456efb19a\branches\independent_test\round-00\spec-repair\skill_artifacts\final.spectra
environment highwater, methane
system pump

test declared_variables:
  kind variable_ownership
  env highwater, methane
  sys pump

test methane_forces_pump_off_single_step:
  kind always_implication
  requirement "If methane is true, then pump must be false in the next step."
  trace:
    highwater=false, methane=true
  when methane=true
  then pump=false

test methane_priority_over_highwater:
  kind always_implication
  requirement "If methane is true, then pump must be false in the next step."
  trace:
    highwater=true, methane=true
  when methane=true
  then pump=false

test highwater_without_methane_activates_pump:
  kind always_implication
  requirement "If highwater is true and methane is false, then pump must be true in the next step."
  trace:
    highwater=true, methane=false
  when highwater=true, methane=false
  then pump=true

test methane_clears_then_safe_highwater_activates:
  kind state_sequence
  requirement "The pump deactivates when methane is detected and activates to clear water when highwater is true and methane is false."
  trace:
    highwater=false, methane=true
    highwater=true, methane=false
  expect:
    pump=false
    pump=true

test safe_pump_then_methane_shutdown:
  kind state_sequence
  requirement "The pump activates when highwater is true and methane is false, and if methane is true then pump must be false in the next step."
  trace:
    highwater=true, methane=false
    highwater=false, methane=true
  expect:
    pump=true
    pump=false

test exhaustive_one_step_methane_shutdown:
  kind always_implication
  mode exhaustive
  max_depth 1
  max_paths 4
  requirement "If methane is true, then pump must be false in the next step."
  domains:
    highwater false, true
    methane false, true
  when methane=true
  then pump=false

test exhaustive_one_step_safe_highwater_activation:
  kind always_implication
  mode exhaustive
  max_depth 1
  max_paths 4
  requirement "If highwater is true and methane is false, then pump must be true in the next step."
  domains:
    highwater false, true
    methane false, true
  when highwater=true, methane=false
  then pump=true
