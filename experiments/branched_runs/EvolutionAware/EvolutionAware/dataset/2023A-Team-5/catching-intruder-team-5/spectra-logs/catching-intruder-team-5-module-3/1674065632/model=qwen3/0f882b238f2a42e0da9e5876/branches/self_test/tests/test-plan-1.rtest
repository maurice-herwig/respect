environment intruderX, intruderY
system robotX0, robotY0, robotX1, robotY1

test declared_variables:
  kind variable_ownership

test robot0_no_column_2_on_row_1:
  kind exclusion
  requirement "Whenever Robot 0's vertical coordinate robotY0 equals 1, Robot 0's horizontal coordinate robotX0 must be either less than 2 or greater than 5."
  trace:
    intruderX=0, intruderY=1
    intruderX=6, intruderY=1
    intruderX=3, intruderY=0
    intruderX=5, intruderY=2
  forbidden robotX0=2, robotY0=1

