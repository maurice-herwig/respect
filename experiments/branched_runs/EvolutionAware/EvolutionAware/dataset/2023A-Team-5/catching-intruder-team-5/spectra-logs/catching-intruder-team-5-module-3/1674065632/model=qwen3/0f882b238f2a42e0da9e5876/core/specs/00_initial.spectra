spec Module3

define D := 7;

type Dim = Int(0..D);

env Dim intruderX;
env Dim intruderY;

sys Dim robotX0;
sys Dim robotY0;
sys Dim robotX1;
sys Dim robotY1;

asm intruder_safe_row:
  G (intruderY = 1 -> (intruderX < 2 | intruderX > 5));

gar robot0_safe_row:
  G (robotY0 = 1 -> (robotX0 < 2 | robotX0 > 5));

gar robot1_safe_row:
  G (robotY1 = 1 -> (robotX1 < 2 | robotX1 > 5));
