spec CatchingIntruder

define D := 7;

type Dim = Int(0..D);

env Dim intruderX;
env Dim intruderY;

sys Dim robotX0;
sys Dim robotY0;
sys Dim robotX1;
sys Dim robotY1;

gar intruder_never_on_robot0:
  alw !(intruderX = robotX0 & intruderY = robotY0);

gar intruder_never_on_robot1:
  alw !(intruderX = robotX1 & intruderY = robotY1);

gar trivial_system_objective:
  true;
