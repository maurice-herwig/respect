controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\EvolutionAware\EvolutionAware\dataset\2023A-Team-9\catching-intruder-team-9-module-3\spectra-logs\CatchingIntruder\1674499467\model=qwen3\011d1594eaa36e404422fcb5\core\synthesis\jit
spec_name CatchingIntruder
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\EvolutionAware\EvolutionAware\dataset\2023A-Team-9\catching-intruder-team-9-module-3\spectra-logs\CatchingIntruder\1674499467\model=qwen3\011d1594eaa36e404422fcb5\core\skill_artifacts\final.spectra
environment intruderX, intruderY
system robotX0, robotY0, robotX1, robotY1

test declared_variables:
  kind variable_ownership
  env intruderX, intruderY
  sys robotX0, robotY0, robotX1, robotY1

test robot0_not_on_intruder_origin:
  kind exclusion
  requirement "It is assumed that the intruder never occupies the same position as Robot 0."
  trace:
    intruderX=0, intruderY=0
    intruderX=0, intruderY=0
  forbidden intruderX=0, intruderY=0, robotX0=0, robotY0=0

test robot1_not_on_intruder_origin:
  kind exclusion
  requirement "It is assumed that the intruder never occupies the same position as Robot 1."
  trace:
    intruderX=0, intruderY=0
    intruderX=0, intruderY=0
  forbidden intruderX=0, intruderY=0, robotX1=0, robotY1=0

test robot0_not_on_intruder_upper_corner:
  kind exclusion
  requirement "It is assumed that the intruder never occupies the same position as Robot 0."
  trace:
    intruderX=7, intruderY=7
    intruderX=7, intruderY=7
  forbidden intruderX=7, intruderY=7, robotX0=7, robotY0=7

test robot1_not_on_intruder_upper_corner:
  kind exclusion
  requirement "It is assumed that the intruder never occupies the same position as Robot 1."
  trace:
    intruderX=7, intruderY=7
    intruderX=7, intruderY=7
  forbidden intruderX=7, intruderY=7, robotX1=7, robotY1=7

test robot0_not_on_intruder_opposite_corner:
  kind exclusion
  requirement "It is assumed that the intruder never occupies the same position as Robot 0."
  trace:
    intruderX=0, intruderY=7
    intruderX=7, intruderY=0
  forbidden intruderX=7, intruderY=0, robotX0=7, robotY0=0

test robot1_not_on_intruder_opposite_corner:
  kind exclusion
  requirement "It is assumed that the intruder never occupies the same position as Robot 1."
  trace:
    intruderX=0, intruderY=7
    intruderX=7, intruderY=0
  forbidden intruderX=7, intruderY=0, robotX1=7, robotY1=0

test robot0_not_on_intruder_interior:
  kind exclusion
  requirement "These conditions must hold at all times during the operation of the system."
  trace:
    intruderX=3, intruderY=4
    intruderX=4, intruderY=3
    intruderX=3, intruderY=4
  forbidden intruderX=3, intruderY=4, robotX0=3, robotY0=4

test robot1_not_on_intruder_interior:
  kind exclusion
  requirement "These conditions must hold at all times during the operation of the system."
  trace:
    intruderX=4, intruderY=3
    intruderX=3, intruderY=4
    intruderX=4, intruderY=3
  forbidden intruderX=4, intruderY=3, robotX1=4, robotY1=3

test robot0_random_boundary_collision_probe:
  kind exclusion
  mode random
  runs 50
  max_depth 6
  seed 9
  requirement "The intruder never occupies the same position as Robot 0."
  domains:
    intruderX 0, 7
    intruderY 0, 7
  forbidden intruderX=7, intruderY=7, robotX0=7, robotY0=7

test robot1_random_boundary_collision_probe:
  kind exclusion
  mode random
  runs 50
  max_depth 6
  seed 10
  requirement "The intruder never occupies the same position as Robot 1."
  domains:
    intruderX 0, 7
    intruderY 0, 7
  forbidden intruderX=0, intruderY=0, robotX1=0, robotY1=0
