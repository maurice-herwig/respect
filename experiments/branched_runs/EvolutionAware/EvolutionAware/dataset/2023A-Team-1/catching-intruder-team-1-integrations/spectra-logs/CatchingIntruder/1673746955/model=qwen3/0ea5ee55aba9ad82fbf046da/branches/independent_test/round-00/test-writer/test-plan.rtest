controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\EvolutionAware\EvolutionAware\dataset\2023A-Team-1\catching-intruder-team-1-integrations\spectra-logs\CatchingIntruder\1673746955\model=qwen3\0ea5ee55aba9ad82fbf046da\core\synthesis\jit
spec_name CatchingIntruder
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\EvolutionAware\EvolutionAware\dataset\2023A-Team-1\catching-intruder-team-1-integrations\spectra-logs\CatchingIntruder\1673746955\model=qwen3\0ea5ee55aba9ad82fbf046da\core\skill_artifacts\final.spectra
environment intruderX, intruderY
system robotX0, robotY0, robotX1, robotY1

test declared_variables:
  kind variable_ownership
  env intruderX, intruderY
  sys robotX0, robotY0, robotX1, robotY1

test initial_positions_at_origin_intruder:
  kind initial_condition
  requirement "Initially, Robot 0 is positioned at coordinates (0, 0) and Robot 1 is positioned at coordinates (5, 0)."
  inputs intruderX=0, intruderY=0
  expected robotX0=0, robotY0=0, robotX1=5, robotY1=0

test initial_positions_at_upper_boundary_intruder:
  kind initial_condition
  requirement "The intruder coordinates range from 0 to 7, and initially Robot 0 is at (0, 0) and Robot 1 is at (5, 0)."
  inputs intruderX=7, intruderY=7
  expected robotX0=0, robotY0=0, robotX1=5, robotY1=0

test initial_positions_at_mixed_intruder:
  kind initial_condition
  requirement "Initially, Robot 0 is positioned at coordinates (0, 0) and Robot 1 is positioned at coordinates (5, 0)."
  inputs intruderX=3, intruderY=5
  expected robotX0=0, robotY0=0, robotX1=5, robotY1=0
