          "carA": "false",
          "carB": "false"
        },
        {
          "carA": "true",
          "carB": "false"
        },
        {
          "carA": "true",
          "carB": "true"
        },
        {
          "carA": "false",
          "carB": "true"
        },
        {
          "carA": "false",
          "carB": "false"
        }
      ],
      "forbidden": {
