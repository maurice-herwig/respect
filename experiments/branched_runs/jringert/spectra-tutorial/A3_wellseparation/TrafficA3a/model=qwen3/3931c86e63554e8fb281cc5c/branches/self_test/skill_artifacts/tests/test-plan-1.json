      "max_depth": 5,
      "max_paths": 256,
      "env": {
        "carA": [
          "false",
          "true"
        ],
        "carB": [
          "false",
          "true"
        ]
      },
      "variables": [
        "greenA",
        "greenB"
      ]
    },
    {
      "name": "never_both_green_concrete",
      "kind": "exclusion",
