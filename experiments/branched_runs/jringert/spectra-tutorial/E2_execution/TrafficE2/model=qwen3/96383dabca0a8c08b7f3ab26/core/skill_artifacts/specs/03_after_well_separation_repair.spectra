spec TrafficE2

env boolean carA;
env boolean carB;

sys boolean greenA;
sys boolean greenB;

asm carA_infinitely_often:
  alwEv carA;

asm carB_infinitely_often:
  alwEv carB;

gar never_both_green:
  G !(greenA & greenB);

gar greenA_infinitely_often:
  alwEv greenA;

gar greenB_infinitely_often:
  alwEv greenB;
