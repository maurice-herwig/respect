controller_dir C:/Users/mauri/OneDrive/Desktop/Repos/respect/experiments/branched_runs/jringert/spectra-tutorial/L4_triggers/TrafficL4/model=qwen3/8a4a6b4b5739630643a85c9b/core/synthesis/jit
spec_name TrafficL4
spectra_file C:/Users/mauri/OneDrive/Desktop/Repos/respect/experiments/branched_runs/jringert/spectra-tutorial/L4_triggers/TrafficL4/model=qwen3/8a4a6b4b5739630643a85c9b/branches/self_test/specs/00_from_core.spectra
environment carA, carB
system greenA, greenB

test declared_variables:
  kind variable_ownership

test exhaustive_never_both_green:
  kind mutual_exclusion
  requirement "The system must never allow both greenA and greenB to be true simultaneously."
  mode exhaustive
  max_depth 6
  max_paths 4096
  domains:
    carA false, true
    carB false, true
  variables greenA, greenB

test random_never_both_green:
  kind mutual_exclusion
  requirement "The system must never allow both greenA and greenB to be true simultaneously."
  mode random
  runs 64
  max_depth 10
  seed 8
  domains:
    carA false, true
    carB false, true
  variables greenA, greenB

test carA_four_steps_eventually_greenA:
  kind eventually_response
  requirement "If carA is present while greenA is false for 4 consecutive time steps, the system must eventually set greenA to true."
  trace:
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
  when carA=true, greenA=false
  eventually greenA=true
  within_steps 5
  require_closed_obligations true
