controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\jringert\spectra-tutorial\L4_triggers\TrafficL4\model=qwen3\8a4a6b4b5739630643a85c9b\core\synthesis\jit
spec_name TrafficL4
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\jringert\spectra-tutorial\L4_triggers\TrafficL4\model=qwen3\8a4a6b4b5739630643a85c9b\core\skill_artifacts\final.spectra
environment carA, carB
system greenA, greenB

test declared_variables:
  kind variable_ownership
  env carA, carB
  sys greenA, greenB

test exhaustive_never_both_green:
  kind mutual_exclusion
  requirement "The system must never allow both greenA and greenB to be true simultaneously."
  mode exhaustive
  max_depth 6
  max_paths 256
  domains:
    carA false, true
    carB false, true
  variables greenA, greenB

test idle_inputs_never_both_green:
  kind exclusion
  requirement "The system must never allow both greenA and greenB to be true simultaneously."
  trace:
    carA=false, carB=false
    carA=false, carB=false
    carA=false, carB=false
    carA=false, carB=false
    carA=false, carB=false
    carA=false, carB=false
  forbidden greenA=true, greenB=true

test simultaneous_cars_never_both_green:
  kind exclusion
  requirement "The system must never allow both greenA and greenB to be true simultaneously."
  trace:
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
  forbidden greenA=true, greenB=true

test delayed_carB_assumption_boundary_safety:
  kind exclusion
  requirement "Whenever carA is true, carB must be true within 0 to 3 time steps, and both green lights must never be true simultaneously."
  trace:
    carA=true, carB=false
    carA=true, carB=false
    carA=true, carB=false
    carA=true, carB=true
    carA=false, carB=true
    carA=false, carB=false
  forbidden greenA=true, greenB=true

test persistent_A_request_eventually_greenA:
  kind eventually_response
  requirement "If carA is true while greenA is false for 4 consecutive time steps, the system must eventually set greenA to true."
  trace:
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
  eventually greenA=true
  within_steps 10
  require_closed_obligations true

test delayed_carB_then_persistent_A_eventually_greenA:
  kind eventually_response
  requirement "If carA is true while greenA is false for 4 consecutive time steps, the system must eventually set greenA to true."
  trace:
    carA=true, carB=false
    carA=true, carB=false
    carA=true, carB=false
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
    carA=true, carB=true
  eventually greenA=true
  within_steps 10
  require_closed_obligations true
