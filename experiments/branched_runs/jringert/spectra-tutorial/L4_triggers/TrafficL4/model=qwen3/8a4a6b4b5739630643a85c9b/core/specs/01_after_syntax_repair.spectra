spec TrafficL4

env boolean carA;
env boolean carB;

sys boolean greenA;
sys boolean greenB;

asm env_carA_reaches_carB_within_3:
  trig [carA] |=> ([carB] | [true] [carB] | [true] [true] [carB] | [true] [true] [true] [carB]);

gar only_one_green:
  alw !(greenA & greenB);

gar carA_waiting_eventually_greenA:
  trig [carA & !greenA] [carA & !greenA] [carA & !greenA] [carA & !greenA] |=> [greenA];
