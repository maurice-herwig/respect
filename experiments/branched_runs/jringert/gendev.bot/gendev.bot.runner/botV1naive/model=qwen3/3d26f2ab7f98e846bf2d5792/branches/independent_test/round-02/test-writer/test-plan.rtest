controller_dir C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\jringert\gendev.bot\gendev.bot.runner\botV1naive\model=qwen3\3d26f2ab7f98e846bf2d5792\branches\independent_test\round-01\spec-repair\synthesis\jit
spec_name BotV1naive
spectra_file C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\jringert\gendev.bot\gendev.bot.runner\botV1naive\model=qwen3\3d26f2ab7f98e846bf2d5792\branches\independent_test\round-01\spec-repair\skill_artifacts\final.spectra
environment distance
system leftM, rightM

test declared_variables:
  kind variable_ownership
  env distance
  sys leftM, rightM

test next_state_not_forward_after_zero_distance:
  kind response_absence
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  trace:
    distance=0
    distance=100
    distance=100
  when distance=0
  absent leftM=FWD, rightM=FWD
  for_steps 1

test next_state_not_forward_after_boundary_distance_20:
  kind response_absence
  requirement "At all times, if the current distance value is less than or equal to 20, then in the immediately next state, the system must not be in the forward condition."
  trace:
    distance=20
    distance=21
    distance=100
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1

test next_state_not_forward_after_repeated_low_distance:
  kind response_absence
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  trace:
    distance=19
    distance=19
    distance=19
    distance=21
  when distance=19
  absent leftM=FWD, rightM=FWD
  for_steps 1

test next_state_not_forward_after_unsafe_drop:
  kind response_absence
  requirement "At all times, if the current distance value is less than or equal to 20, then in the immediately next state, the system must not be in the forward condition."
  trace:
    distance=100
    distance=21
    distance=20
    distance=100
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1

test next_state_not_forward_after_alternating_low_values:
  kind response_absence
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  trace:
    distance=0
    distance=20
    distance=1
    distance=100
  when distance=0
  absent leftM=FWD, rightM=FWD
  for_steps 1

test bounded_random_low_distance_safety:
  kind response_absence
  mode random
  runs 50
  max_depth 6
  seed 3
  requirement "At all times, if the current distance value is less than or equal to 20, then in the immediately next state, the system must not be in the forward condition."
  domains:
    distance 0, 1, 19, 20, 21, 100
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1

test bounded_exhaustive_boundary_safety:
  kind response_absence
  mode exhaustive
  max_depth 4
  max_paths 256
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  domains:
    distance 19, 20, 21
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1
