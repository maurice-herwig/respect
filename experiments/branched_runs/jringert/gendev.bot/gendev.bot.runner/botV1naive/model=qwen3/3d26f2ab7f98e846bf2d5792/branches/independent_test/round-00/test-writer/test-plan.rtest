controller_dir "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\jringert\gendev.bot\gendev.bot.runner\botV1naive\model=qwen3\3d26f2ab7f98e846bf2d5792\core\synthesis\jit"
spec_name BotV1naive
spectra_file "C:\Users\mauri\OneDrive\Desktop\Repos\respect\experiments\branched_runs\jringert\gendev.bot\gendev.bot.runner\botV1naive\model=qwen3\3d26f2ab7f98e846bf2d5792\core\skill_artifacts\final.spectra"
environment distance
system leftM, rightM

test declared_variables:
  kind variable_ownership
  env distance
  sys leftM, rightM

test immediate_stop_after_zero_distance:
  kind response_absence
  requirement "At all times, if the current distance value is less than or equal to 20, then in the immediately next state, the system must not be in the forward condition."
  trace:
    distance=0
    distance=0
  when distance=0
  absent leftM=FWD, rightM=FWD
  for_steps 1

test immediate_stop_after_near_zero_distance:
  kind response_absence
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  trace:
    distance=1
    distance=1
  when distance=1
  absent leftM=FWD, rightM=FWD
  for_steps 1

test immediate_stop_after_just_below_boundary:
  kind response_absence
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  trace:
    distance=19
    distance=19
  when distance=19
  absent leftM=FWD, rightM=FWD
  for_steps 1

test immediate_stop_after_boundary_distance:
  kind response_absence
  requirement "At all times, if the current distance value is less than or equal to 20, then in the immediately next state, the system must not be in the forward condition."
  trace:
    distance=20
    distance=20
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1

test safe_to_unsafe_transition_blocks_next_forward:
  kind response_absence
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  trace:
    distance=100
    distance=21
    distance=20
    distance=20
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1

test alternating_boundary_values_block_after_low:
  kind response_absence
  requirement "At all times, if the current distance value is less than or equal to 20, then in the immediately next state, the system must not be in the forward condition."
  trace:
    distance=21
    distance=20
    distance=21
    distance=19
    distance=100
    distance=0
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1

test random_representative_low_distance_safety:
  kind response_absence
  mode random
  runs 50
  max_depth 6
  seed 7
  requirement "Whenever the measured distance is 20 or less, the subsequent motor commands cannot have both leftM and rightM set to FWD."
  domains:
    distance 0, 1, 19, 20, 21, 100
  when distance=20
  absent leftM=FWD, rightM=FWD
  for_steps 1
