spec GyroBalancer

type Distance = {CLEAR, BLOCKED};
type BalanceState = {STP, FWD, BWD, TURN_LEFT, TURN_RIGHT};

env Distance distSense;
env boolean isReady;

sys BalanceState balancer;

asm ini !isReady;
asm alw isReady -> next(isReady);
asm alwEv isReady;

asm alw balancer != FWD -> next(distSense=CLEAR);
asm alwEv distSense=CLEAR;

gar ini balancer=STP;
gar alw !isReady -> balancer=STP;

gar alw isReady & distSense=BLOCKED -> balancer!=FWD;
gar alw isReady & distSense=CLEAR -> balancer=FWD;

gar alw balancer=FWD -> next(balancer!=TURN_LEFT & balancer!=TURN_RIGHT);
gar alw distSense=BLOCKED & balancer=STP & isReady -> next(balancer!=STP);

gar alwEv balancer=FWD;
